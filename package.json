{
  "name": "foxtheme-base",
  "version": "1.0.0",
  "main": "index.js",
  "author": "FoxEcom",
  "license": "MIT",
  "devDependencies": {
    "@shopify/cli": "4.5.2",
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "@shopify/theme-check-node": "3.24.0",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "fs-extra": "^11.3.0",
    "glob": "^10.3.10",
    "husky": "^9.1.7",
    "json5": "^2.2.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "sass": "^1.89.1",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "terser": "^5.43.1",
    "vite": "^6.3.5"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node scripts/generate-project-map.js || true; node scripts/build-motion-manifest.mjs || true",
    "deploy:dev": "shopify theme push -e development --allow-live",
    "deploy:test": "shopify theme push -e test --allow-live",
    "deploy:intro": "shopify theme push -e intro --allow-live",
    "theme:preset": "shopify theme push -e preset --allow-live",
    "build:css": "node scripts/build-css.js",
    "watch:css": "node scripts/build-css.js --watch",
    "copy:images": "node scripts/copy-images.js",
    "clean:assets": "rimraf assets/*.{css,jpg,jpeg,png,gif,svg,js,mjs}",
    "watch:images": "node scripts/copy-images.js --watch",
    "copy:js": "node scripts/copy-js.js",
    "watch:js": "node scripts/copy-js.js --watch",
    "build:js-vite": "vite build",
    "minify:library": "node scripts/minify-library.js",
    "watch:js-vite": "vite build --watch",
    "start": "yarn clean:assets && yarn build:css && yarn build:js-vite && yarn copy:images && yarn copy:js && concurrently -k \"yarn watch:images --skip-initial-copy\" \"yarn watch:css --skip-initial-build\" \"yarn watch:js --skip-initial-copy\" \"yarn watch:js-vite\" \"node scripts/theme-dev.mjs -e development\"",
    "start:events": "yarn clean:assets && yarn build:css && yarn build:js-vite && yarn copy:images && yarn copy:js && concurrently -k \"yarn watch:images --skip-initial-copy\" \"yarn watch:css --skip-initial-build\" \"yarn watch:js --skip-initial-copy\" \"yarn watch:js-vite\" \"node scripts/theme-dev.mjs -e development --standard-events-inspector\"",
    "build:assets": "yarn build:css && yarn build:js-vite && yarn copy:images && yarn copy:js",
    "wt:add": "node scripts/wt-add.mjs",
    "wt:dev": "node scripts/wt-dev.mjs",
    "wt:clean": "node scripts/wt-clean.mjs",
    "wt:theme": "node scripts/wt-theme.mjs",
    "chrome:agents": "node scripts/chrome-agents.mjs",
    "zip": "yarn clean:assets && yarn build:css && yarn build:js-vite && node scripts/copy-js.js --strip-comments && yarn copy:images && yarn minify:library && node scripts/zip.js",
    "zip:quick": "yarn build:css && yarn build:js-vite && yarn copy:js && yarn copy:images && yarn minify:library && node scripts/zip.js",
    "format": "prettier --write .",
    "lint:css": "stylelint \"src/scss/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/scss/**/*.scss\" --fix",
    "lint:css:file": "stylelint",
    "map": "node scripts/generate-project-map.js",
    "check-missing-translate": "node scripts/check-missing-translate.js",
    "check-unused-translate": "node scripts/check-unused-translate.js",
    "check-unused-translate:fail": "node scripts/check-unused-translate.js --fail",
    "clean-unused-translate": "node scripts/clean-unused-translate.js --write",
    "check-template-refs": "node scripts/check-template-refs.js",
    "check-template-refs:fail": "node scripts/check-template-refs.js --fail",
    "clean-template-refs": "node scripts/clean-template-refs.js",
    "motion:build": "node scripts/build-motion-prestage.mjs",
    "motion:manifest": "node scripts/build-motion-manifest.mjs",
    "check-motion-manifest": "node scripts/build-motion-manifest.mjs --check",
    "check-motion-presets": "node scripts/check-motion-presets.js",
    "check-motion-easing": "node scripts/check-motion-easing.js",
    "check-motion-prestage": "node scripts/build-motion-prestage.mjs --check",
    "check-capability-headers": "node scripts/check-capability-headers.mjs",
    "check-capability-headers:baseline": "node scripts/check-capability-headers.mjs --baseline",
    "check-js-contract": "node scripts/check-js-contract.js --diff",
    "check-js-contract:strict": "node scripts/check-js-contract.js",
    "check-js-contract:baseline": "node scripts/check-js-contract.js --baseline",
    "check-selector-interp": "node scripts/check-selector-interp.js",
    "check-selector-interp:strict": "node scripts/check-selector-interp.js --strict",
    "check-selector-interp:baseline": "node scripts/check-selector-interp.js --baseline",
    "check-settings-schema": "node scripts/check-settings-schema.js",
    "check-range-steps": "node scripts/check-range-steps.js",
    "check-visible-if": "node scripts/check-visible-if.js",
    "check-preset-values": "node scripts/check-preset-values.js",
    "check-render-filters": "node scripts/check-render-filters.js",
    "check-image-preload": "node scripts/check-image-preload.js",
    "check-doc-newline": "node scripts/check-doc-newline.js",
    "check-inline-assets": "node scripts/check-inline-assets.js",
    "check-contrast": "node scripts/check-contrast.js",
    "check-contrast:strict": "node scripts/check-contrast.js --strict",
    "check-contrast:baseline": "node scripts/check-contrast.js --baseline",
    "check-shorthand-scheme-var": "node scripts/check-shorthand-scheme-var.js",
    "check-shorthand-scheme-var:baseline": "node scripts/check-shorthand-scheme-var.js --baseline",
    "check-listings": "node scripts/check-listings.mjs",
    "listings:pad-schemes": "node scripts/pad-color-schemes.mjs",
    "audit:coverage": "node scripts/audit-coverage.mjs",
    "audit:url": "node scripts/audit-url.mjs",
    "check-toolkit-refs": "node scripts/check-toolkit-refs.mjs",
    "check-liquid": "OPT_OUT_INSTRUMENTATION=true node scripts/check-liquid.mjs --theme-path .",
    "core:diff": "node scripts/core-sync.mjs diff",
    "core:dry-merge": "node scripts/core-sync.mjs dry-merge",
    "core:sync": "node scripts/core-sync.mjs sync",
    "theme:bump-store-version": "node scripts/bump-store-version.mjs",
    "theme:store-state": "node scripts/store-state.mjs",
    "theme:tag-submit": "node scripts/tag-submit.mjs",
    "theme:tag-store": "node scripts/tag-store.mjs",
    "clean-data-json": "node scripts/clean-data-json.js",
    "clean-data-json:release": "node scripts/clean-data-json.js --release",
    "test-presets": "node scripts/test-presets.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@ungap/custom-elements": "^1.3.0",
    "lenis": "^1.3.26",
    "motion": "10.16.2",
    "photoswipe": "^5.4.4",
    "swiper": "^11.2.8"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

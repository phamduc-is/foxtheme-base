{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "plugins": [
    "@shopify/prettier-plugin-liquid"
  ],
  "overrides": [
    {
      "files": "**/*.liquid",
      "options": {
        "parser": "liquid-html",
        "printWidth": 150,
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
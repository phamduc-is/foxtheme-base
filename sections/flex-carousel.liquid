{%- liquid
  assign columns_desktop = section.settings.columns
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign enable_swipe_mobile = section.settings.enable_swipe_on_mobile
  assign swipe_custom_width_column = section.settings.swipe_custom_width_column

  # Every breakpoint starts at the single `columns` value — the behaviour before
  # `custom_columns` existed — and only the pairs the merchant actually typed
  # move. Parsed only in `columns` mode: an 'auto' track has no column count to
  # override, which is why the setting is gated on the same condition.
  assign columns_md = columns_desktop
  assign columns_lg = columns_desktop
  assign columns_xl = columns_desktop
  assign columns_xxl = columns_desktop

  # Only the DESKTOP track can be 'auto'. Below 768 Swiper is torn down
  # (destroyBelow) and the row is a CSS grid, so `columns_mobile` is that grid's
  # column count — the merchant's own `columns_mobile` choice — not a
  # slidesPerView value. Passing 'auto' down here left --f-columns-mobile
  # invalid and collapsed the grid to one implicit column.
  if section.settings.slides_per_view == 'auto'
    assign columns_desktop = 'auto'
    assign columns_md = 'auto'
    assign columns_lg = 'auto'
    assign columns_xl = 'auto'
    assign columns_xxl = 'auto'
  elsif section.settings.custom_columns != blank
    assign custom_columns_array = section.settings.custom_columns | split: ','
    for custom_column in custom_columns_array
      assign pair = custom_column | strip
      if pair == ''
        continue
      endif

      assign custom_column_key = pair | split: ':' | first | strip
      assign value_str = pair | split: ':' | last | strip
      if value_str == ''
        continue
      endif
      assign custom_column_value = value_str | plus: 0

      comment
        Guard on the NUMBER: `split` drops a trailing empty field, so `"md:"` yields
        `"md"` from `| last` — past the `value_str == ''` guard — and `| plus: 0` makes
        it 0, collapsing that breakpoint to one column. See sections/collection-list.liquid.
      endcomment
      if custom_column_value < 1
        continue
      endif

      case custom_column_key
        when 'mb'
          assign columns_mobile = custom_column_value
        when 'md'
          assign columns_md = custom_column_value
        when 'lg'
          assign columns_lg = custom_column_value
        when 'xl'
          assign columns_xl = custom_column_value
        when 'xxl'
          assign columns_xxl = custom_column_value
      endcase
    endfor
  endif

  assign column_gap = section.settings.column_gap
  assign column_gap_mobile = section.settings.column_gap_mobile
  assign row_gap_mobile = section.settings.row_gap_mobile

  # The 768-1199 band owns neither knob the merchant sets, and used to be a
  # hardcoded 16px that ignored both. 60% of the desktop gap, floored at the
  # mobile gap so a tablet never reads tighter than the phone it sits above.
  assign column_gap_tablet = column_gap | times: 0.6 | round | at_least: column_gap_mobile

  # Swiper only needs to know whether a bullets element will exist; the layout itself is
  # resolved inside `carousel-controls` from the same setting.
  assign ctl = section.settings.carousel_controls
  assign show_dots = false
  if ctl == 'dots' or ctl == 'group' or ctl == 'float_dots'
    assign show_dots = true
  endif

  assign swipe_mobile_classes = ''
  assign swipe_mobile_inner_classes = ''
  if enable_swipe_mobile
    assign swipe_mobile_classes = ' swipe__element swipe-mobile swipe-mobile--[columns]-cols' | replace: '[columns]', columns_mobile
    assign swipe_mobile_inner_classes = ' swipe__inner'

    if swipe_custom_width_column
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--custom-width'
    endif
    if section.settings.swipe_rows_mobile > 1
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--rows-' | append: section.settings.swipe_rows_mobile
    endif
  endif

  # The list entrance goes on the slide row, so the whole carousel arrives as one
  # sequence instead of each card racing its neighbours into view. Every value
  # except 'none' IS a preset name and passes straight through; motion-group
  # validates it against the registry and falls back rather than hiding the row.
  #
  # Defaults to 'none' on purpose. The cards here carry blocks with their own
  # animation settings, and a group takes those over — see #standDownForGroup in
  # motion-component. Defaulting to an effect would therefore silently retire a
  # per-block choice on every carousel already out there.
  assign list_motion = ''
  assign list_sequence = false
  if settings.animations_enabled
    assign content_animation = section.settings.content_animation
    if content_animation != 'none' and content_animation != blank
      assign list_motion = content_animation
      if section.settings.content_animation_sequence
        assign list_sequence = true
      endif
    endif
  endif

  capture section_header
    content_for 'block', type: '_section-header-vertical', id: 'section-header-vertical'
  endcapture
-%}
<div
  class="spacing-style border-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}{% render 'border-style', settings: section.settings %}"
>
  <div class="{{ section.settings.container }}">
    {{ section_header }}
    {%- capture carousel_style -%}
      {%- comment -%}
        row_gap 0 on purpose: above 768 the wrapper is Swiper's nowrap flex row, where a
        row gap is inert. It only exists for the mobile grid, so it is a mobile-only knob.
      {%- endcomment -%}
      {% render 'gap-style',
        column_gap_mobile: column_gap_mobile,
        column_gap: column_gap,
        row_gap_mobile: row_gap_mobile,
        row_gap: 0
      %}
      {%- unless columns_desktop == 'auto' -%}
        {%- comment -%}
          'auto' would poison --f-slide-width in the pre-init CLS rules. All four
          are emitted rather than xxl alone: swiper.scss resolves --f-slide-width
          through an md→lg→xl→xxl fallback chain, so a `custom_columns` override
          that only exists in the Swiper config would leave the pre-init row
          laid out at the WRONG count until init — the CLS these vars exist to
          prevent.
        {%- endcomment -%}
        --f-columns-md: {{ columns_md }};
        --f-columns-lg: {{ columns_lg }};
        --f-columns-xl: {{ columns_xl }};
        --f-columns-xxl: {{ columns_xxl }};
      {%- endunless -%}
      --f-columns-mobile: {{ columns_mobile }};
      {%- comment -%}
        Consumed by _section-flex-carousel.scss to hold the pre-init row at the
        same tablet gap Swiper applies on init — --f-column-gap-max alone is the
        full desktop gap, and the row visibly re-flowed the moment Swiper booted.
      {%- endcomment -%}
      --f-column-gap-tablet: {{ column_gap_tablet | divided_by: 10.0 }}rem;
      {% if swipe_custom_width_column %}
        --swipe-column-width: {{ section.settings.swipe_column_width | divided_by: 100.0 }};
      {% endif %}
    {%- endcapture -%}
    <flex-carousel
      data-section-id="{{ section.id }}"
      class="block carousel carousel--grid{% if columns_desktop == 'auto' %} carousel--view-auto{% endif %} flex-carousel flex-carousel--{{ section.settings.slides_per_view }} {% render 'carousel-class', settings: section.settings %}"
      style="{{ carousel_style }}"
    >
      <script type="application/json" ref="config">
        {
          "shopifyBlocks": true,
          "loop": false,
          "slideClass": "swiper-slide-custom",
          "slidesPerView": {{ columns_mobile | json }},
          "slidesPerGroup": {% render 'carousel-slides-per-group' %},
          "spaceBetween": {{ column_gap_mobile }},
          {%- comment -%}
            EVERY entry repeats spaceBetween on purpose. Swiper's setBreakpoint
            does `extend(swiper.params, breakpointParams)` with the ONE matching
            breakpoint — it does not accumulate the entries below it — so a key
            left out here resolves to whatever params already held: the base
            (mobile) gap on a direct load at that width, but the previous
            breakpoint's gap if the visitor resized up into it. Same width, two
            different gaps, depending on how the viewport got there.
          {%- endcomment -%}
          "breakpoints": {
            "768": {
              "slidesPerView": {{ columns_md | json }},
              "spaceBetween": {{ column_gap_tablet }}
            },
            "1024": {
              "slidesPerView": {{ columns_lg | json }},
              "spaceBetween": {{ column_gap_tablet }}
            },
            "1200": {
              "slidesPerView": {{ columns_xl | json }},
              "spaceBetween": {{ column_gap }}
            },
            "1440": {
              "slidesPerView": {{ columns_xxl | json }},
              "spaceBetween": {{ column_gap }}
            }
          },
          "destroyBelow": 768,
          "mousewheel": {
            "enabled": true,
            "forceToAxis": true,
            "thresholdTime": 300,
            "thresholdDelta": 10
          },
          "navigationPosition": {
            "enabled": true,
            "selector": ".media .media__image"
          },
          "counter": false,
          "pagination": {% if show_dots %}{ "type": "bullets" }{% else %}false{% endif %}
        }
      </script>
      <div
        {% if section.settings.carousel_edge_fade_mobile %}
          is="swipe-component"
        {% endif -%}
        class="{% render 'carousel-class', settings: section.settings, part: 'viewport-mobile' %}"
      >
        <div class="{% render 'carousel-class', settings: section.settings, part: 'viewport' %}">
          <div
            ref="container"
            class="swiper{{ swipe_mobile_classes }}"
          >
            <div
              {% if list_motion != blank %}
                is="motion-group"
                {% comment %}
                  The cells are the block roots THEMSELVES. A group's default is
                  each cell's first element child, which is right where a section
                  wraps every card in its own positioning div — but here a block
                  renders its own root, and for image-card that first child is
                  the media box. Left on the default the entrance played on the
                  picture while the heading, text and button under it sat still.

                  These blocks ARE the slides (slideClass above), so the slide
                  root is what gets animated, and NOTHING else may put a
                  transform on it: the entrance's start state comes from a
                  stylesheet rule now, and a stylesheet rule with more
                  specificity simply wins — silently, with every check green.
                  Swiper's core is fine (it writes its translate to the WRAPPER,
                  and per-slide transforms only come from the effect modules,
                  none of which this theme bundles), but the theme's own
                  `_section-flex-carousel.scss` used to land a translateZ(0)
                  here and that is exactly how it failed.
                {% endcomment %}
                data-motion-cells=":scope > *"
                {% render 'motion-attributes', type: list_motion, sequence: list_sequence %}
              {% endif %}
              class="swiper-wrapper layout-panel-grid-mobile gap-style{{ swipe_mobile_inner_classes }}"
            >
              {%- for block in section.blocks -%}
                {%- render block -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
      {%- if section.blocks.size > 1 -%}
        {% render 'carousel-controls', ref: 'controls', settings: section.settings, class: 'hidden md:flex' %}
      {%- endif -%}
    </flex-carousel>
  </div>
</div>

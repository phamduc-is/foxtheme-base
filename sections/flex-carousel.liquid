      "label": "t:settings.show_edge_fade",
      "default": false
    },
    {
      "type": "select",
      "id": "slides_per_view",
      "label": "t:settings.slides_per_view",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "columns",
          "label": "t:options.columns"
        }
      ],
      "default": "columns"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.slides_per_view == 'columns' }}"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_on_mobile",
      "label": "t:settings.enable_swipe_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "carousel_edge_fade_mobile",
      "label": "t:settings.show_edge_fade_mobile",
      "default": false,
      "visible_if": "{{ section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "checkbox",
      "id": "swipe_custom_width_column",
      "label": "t:settings.swipe_custom_width_column",
      "default": false,
      "visible_if": "{{ section.settings.enable_swipe_on_mobile == true }}"

            "question_id": "need",
            "stepper_label": "Need",
            "heading": "What are you shopping for?",
            "question_heading_size": "h2",
            "subtext": "Pick the option that fits best.",
            "card_style": "media",
            "card_layout": "vertical",
            "card_color_scheme": "scheme-2",
            "card_radius": 0,
            "columns": 3,
            "columns_mobile": 1
          },
          "blocks": {
            "option_need_1": {
              "type": "_recommendation-quiz-option",
              "settings": {
                "icon": "gift",
                "title": "A gift",
                "subtitle": "Something special for someone else"
              }
            },
            "option_need_2": {
              "type": "_recommendation-quiz-option",

            "option_budget_3": {
              "type": "_recommendation-quiz-option",
              "settings": {
                "title": "Over $100"
              }
            }
          },
          "block_order": [
            "option_budget_1",
            "option_budget_2",
            "option_budget_3"
          ]
        },
        "product-quiz-email": {
          "type": "_product-quiz-email",
          "static": true,
          "blocks": {
            "email-heading": {
              "type": "text",
              "settings": {
                "text": "<h2>Get your results</h2>",
                "type_preset": "h1",
                "width": "100%",
                "text_alignment": "center",
                "width_mobile": "100%",
                "text_alignment_mobile": "center"
              }
            },
            "email-text": {
              "type": "text",
              "settings": {

              "type": "_recommendation-quiz-option",
              "settings": {
                "title": "Some experience",
                "subtitle": "I know the basics"
              }
            },
            "option_level_3": {
              "type": "_recommendation-quiz-option",
              "settings": {
                "title": "Confident",
                "subtitle": "I use it regularly"
              }
            },
            "option_level_4": {
              "type": "_recommendation-quiz-option",
              "settings": {
                "title": "Expert",
                "subtitle": "I know exactly what I want"
              }
            }
          },
          "block_order": [
            "option_level_1",
            "option_level_2",
            "option_level_3",
            "option_level_4"
          ]
        },
        "question_budget": {
          "type": "_recommendation-quiz-question",
          "settings": {
            "question_id": "budget",
            "stepper_label": "Budget",
            "heading": "What is your budget?",
            "question_heading_size": "h2",
            "card_style": "text",
            "card_color_scheme": "scheme-2",
            "card_radius": 0,
            "columns": 3,
            "columns_mobile": 1
          },
          "blocks": {
            "option_budget_1": {
              "type": "_recommendation-quiz-option",
              "settings": {
                "title": "Under $50"
              }
            },
            "option_budget_2": {
              "type": "_recommendation-quiz-option",
              "settings": {
                "title": "$50 – $100"
              }

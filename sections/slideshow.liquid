{{ 'scoped-slideshow.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign container = section.settings.container
  assign content_position = section.settings.content_position
  assign height = section.settings.height
  assign height_mobile = section.settings.height_mobile

  assign autoplay = section.settings.autoplay
  assign autoplay_delay = section.settings.autoplay_delay
  # The schema no longer offers a choice here: the select had exactly one option
  # ("Default"), so the merchant could never change it, and no stylesheet targets
  # any `slideshow__controls-*` modifier at all. Keep emitting the class the
  # markup has always carried, from a literal.
  assign control_type = 'default'
-%}

{%- comment -%}
  Height `auto`: Swiper sizes every slide to the tallest, so per-slide ratios leave a gap
  under the shorter ones. Pin the deck to the FIRST slide's media instead. It arrives by
  marker because a THEME block exposes no `settings` on `section.blocks` — only its
  rendered output — which is why the blocks are captured before the wrapper that reads
  them.
{%- endcomment -%}
{%- capture slides_html -%}{% content_for 'blocks' %}{%- endcapture -%}
{%- liquid
  assign first_ratio = ''
  assign first_ratio_mobile = ''

  assign ratio_parts = slides_html | split: '<!-- @slide/ratio/'
  if ratio_parts.size > 1
    assign first_ratio = ratio_parts[1] | split: ' -->' | first
  endif

  assign ratio_mobile_parts = slides_html | split: '<!-- @slide/ratio-mobile/'
  if ratio_mobile_parts.size > 1
    assign first_ratio_mobile = ratio_mobile_parts[1] | split: ' -->' | first
  endif
-%}

{%- capture wrapper_class -%}
  slideshow relative section-grid section-grid--{{ container }}
  {%- if height == 'auto' %} media--adapt{% endif -%}
  {%- if height_mobile == 'auto' %} media-mobile--adapt{% endif -%}
  {%- if container == 'full' %} slideshow--content-{{ content_position }}{% endif -%}
{%- endcapture -%}

{%- capture wrapper_style -%}
  {%- comment -%} Height floor: both custom → one clamp (desktop var + mobile var); one side custom → its fixed var; auto sides emit nothing → 0 floor → media adapts to its image ratio. {%- endcomment -%}
  {%- if height == 'custom' and height_mobile == 'custom' -%}
    {%- render 'clamp-calculate-style', property_name: 'height', min_value: section.settings.height_custom_mobile, max_value: section.settings.height_custom, max_breakpoint: 1455 -%}
  {%- elsif height == 'custom' -%}
    --height: {{ section.settings.height_custom }}px;
  {%- elsif height_mobile == 'custom' -%}
    --height-mobile: {{ section.settings.height_custom_mobile }}px;
  {%- endif -%}
  {%- if height == 'auto' and first_ratio != blank -%}
    --slideshow-ratio: {{ first_ratio }};
  {%- endif -%}
  {%- if height_mobile == 'auto' and first_ratio_mobile != blank -%}
    --slideshow-ratio-mobile: {{ first_ratio_mobile }};
  {%- endif -%}
  {%- if container == 'fixed' -%}
    {%- render 'border-style', settings: section.settings -%}
  {%- endif -%}
{%- endcapture -%}

<div
  class="inherit-color-scheme section section-slideshow spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <slideshow-component
    class="{{ wrapper_class | strip | strip_newlines }}"
    style="{{ wrapper_style | strip | strip_newlines }}"
    data-section-id="{{ section.id }}"
    data-autoplay="{{ autoplay }}"
  >
    <script type="application/json" ref="config">
      {
        "shopifyBlocks": true,
        "loop": true,
        "effect": "fade",
        "fadeEffect": { "crossFade": true },
        "autoplay":{% if autoplay %}{ "delay": {{ autoplay_delay | times: 1000 }} }{% else %}false{% endif %},
        "counter": true,
        "pagination": { "type": "bullets" }
      }
    </script>
    <div
      ref="container"
      class="swiper w-full row-span-full border-style"
    >
      <div class="swiper-wrapper">
        {{ slides_html }}
      </div>
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="slideshow__controls slideshow__controls-{{ control_type }}" ref="controls">
        {% assign class = 'justify-' | append: section.settings.control_alignment %}
        {% render 'carousel-controls', class: class, pagination_style: 'pill-autoplay' %}
      </div>
    {%- endif -%}
  </slideshow-component>
</div>


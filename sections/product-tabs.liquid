{% liquid
  assign heading = section.settings.heading
  if section.settings.heading_highlight_style != 'none'
    capture heading
      render 'highlight-text', text: section.settings.heading, style: section.settings.heading_highlight_style, font_style: section.settings.heading_highlight_font_style, text_color: section.settings.heading_highlight_text_color, shape_color: section.settings.heading_highlight_shape_color
    endcapture
  endif
  assign limit = section.settings.product_count
  assign type = section.settings.type
  assign enable_swipe_on_mobile = section.settings.enable_swipe_on_mobile
  assign swipe_custom_width_column = section.settings.swipe_custom_width_column
  assign column_gap = section.settings.column_gap
  assign columns_xxl = section.settings.columns_xxl
  assign columns_xl = columns_xxl | at_most: 4
  assign columns_lg = columns_xxl | at_most: 3
  assign columns_md = columns_xxl | at_most: 3
  assign columns_mobile = section.settings.columns_mobile | plus: 0

  # Panel entrance. The global Animations toggle is applied HERE rather than in
  # the component: tabs-component ships inside modules.js, which loads
  # unconditionally, so a merchant who switched every animation off still got an
  # animated tab swap.
  assign content_animation = section.settings.content_animation | default: 'fade-up'
  unless settings.animations_enabled
    assign content_animation = 'none'
  endunless
  # The product list owns the entrance for EVERY animated option, not just the
  # sequenced one. A motion-group also animates when the section scrolls into
  # view, which a panel-level entrance cannot: nothing switches tabs on first
  # load, so the first panel would simply sit there until the visitor clicked.
  #
  # Every value except 'none' IS a preset name, so it passes straight through
  # rather than being listed here — adding an entrance to the select is then a
  # schema change and nothing else. motion-group validates the name against the
  # registry and falls back to its default, so a typo degrades instead of
  # leaving the list hidden.
  #
  # 'stagger' is the retired value: it used to mean fade-up AND one-by-one,
  # because the effect and its rhythm shared one select. They are two settings
  # now, so a stored 'stagger' maps to what it always meant.
  assign list_motion = ''
  assign list_sequence = false
  if content_animation == 'stagger'
    assign list_motion = 'fade-up'
    assign list_sequence = true
  elsif content_animation != 'none' and content_animation != blank
    assign list_motion = content_animation
    # Normalised to a real boolean rather than passed through: a section saved
    # before this setting existed reads nil here, and the snippet treats nil as
    # "caller said nothing" — which would sequence a list the merchant never
    # asked to sequence.
    if section.settings.content_animation_sequence
      assign list_sequence = true
    endif
  endif

  if section.settings.custom_columns != blank
    assign custom_columns_array = section.settings.custom_columns | split: ','
    for custom_column in custom_columns_array
      assign pair = custom_column | strip
      if pair == ''
        continue
      endif

      assign custom_column_key = pair | split: ':' | first | strip
      assign value_str = pair | split: ':' | last | strip
      if value_str == ''
        continue
      endif
      assign custom_column_value = value_str | plus: 0

      comment
        Guard on the NUMBER: `split` drops a trailing empty field, so `"md:"` yields
        `"md"` from `| last` — past the `value_str == ''` guard — and `| plus: 0` makes
        it 0, collapsing that breakpoint to one column. See snippets/grid-markup.liquid.
      endcomment
      if custom_column_value < 1
        continue
      endif

      case custom_column_key
        when 'mb'
          assign columns_mobile = custom_column_value
        when 'md'
          assign columns_md = custom_column_value
        when 'lg'
          assign columns_lg = custom_column_value
        when 'xl'
          assign columns_xl = custom_column_value
        when 'xxl'
          assign columns_xxl = custom_column_value
      endcase
    endfor
  endif

  assign swipe_mobile_classes = ''
  assign swipe_mobile_inner_classes = ''

  if enable_swipe_on_mobile
    assign swipe_mobile_classes = 'swipe__element swipe-mobile swipe-mobile--[columns]-cols' | replace: '[columns]', columns_mobile
    assign swipe_mobile_inner_classes = 'swipe__inner'

    if swipe_custom_width_column
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--custom-width'
    endif
    if section.settings.swipe_rows_mobile > 1
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--rows-' | append: section.settings.swipe_rows_mobile
    endif
  endif

  assign use_padding_inline = true
  if section.settings.container != 'full'
    assign use_padding_inline = false
  endif

  assign tabs_html = ''
  assign panels_html = ''
%}
{% capture section_style %}
  {% render 'spacing-style', settings: section.settings, use_padding_inline: use_padding_inline %}
  {% render 'border-style', settings: section.settings %}
  {% if swipe_custom_width_column %}
    --swipe-column-width: {{ section.settings.swipe_column_width | divided_by: 100.0 }};
  {% endif %}
{% endcapture %}

{% capture container_style %}
  {% render 'layout-panel-style', settings: section.settings, type: 'grid', columns_mobile: columns_mobile, columns_md: columns_md, columns_lg: columns_lg, columns_xl: columns_xl, columns_xxl: columns_xxl %}
  {% render 'gap-style', settings: section.settings %}
  {%- if section.settings.container == 'custom' -%}
    --page-width-custom: {{ section.settings.container_custom_width | divided_by: 10.0 }}rem;
  {%- endif -%}
{% endcapture %}

{%- liquid
  assign sizes_page_width = settings.page_width
  if section.settings.container == 'custom'
    assign sizes_page_width = section.settings.container_custom_width
  endif
-%}
{%- capture media_sizes -%}
  {%- capture container_size -%}min(100vw, {{ sizes_page_width | plus: 32 }}px){%- endcapture -%}
  (min-width: 1440px) calc(({{ container_size }} - 32px) / {{ columns_xxl }}), (min-width: 1200px) calc(({{ container_size }} - 32px) / {{ columns_xl }}), (min-width: 1024px) calc(({{ container_size }} - 32px) / {{ columns_lg }}), (min-width: 768px) calc(({{ container_size }} - 32px) / {{ columns_md }}), calc((100vw - 32px) / {{ columns_mobile }})
{%- endcapture -%}

{%- for block in section.blocks -%}
  {%- liquid
    assign collection = block.settings.collection
    assign tab_title = 'Tab [index]' | replace: '[index]', forloop.index
    if block.settings.collection != blank
      assign tab_title = collection.title
    endif
    if block.settings.title != blank
      assign tab_title = block.settings.title
    endif
  -%}
  {%- capture panel_id -%}{{ section.id }}-panel-{{ forloop.index0 }}{%- endcapture -%}
  {%- capture tab_html -%}
    <a
      href="#{{ panel_id }}"
      aria-controls="{{ panel_id }}"
      ref="tab[]"
      on:click="/onTabClick"
      on:keydown="/onKeydown"
      role="tab"
      {%- comment -%}
        Rendered, not left to the runtime — see blocks/_tab.liquid for why.
      {%- endcomment -%}
      aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
      tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
      data-index="{{ forloop.index0 }}"
      class="tabs__button inline-flex items-center justify-center relative rounded"
    >
      <span class="tabs__button-text relative text-ellipsis" data-label="{{ tab_title | escape }}">{{ tab_title }}</span>
    </a>
  {%- endcapture -%}

  {%- capture list_items -%}
    {% if collection != blank and shop.products_count != 0 %}
      {% paginate collection.products by limit %}
        {% for product in collection.products limit: limit %}
          <div class="f-column{% if type == 'carousel' %} swiper-slide{% endif %}">
            {%- render 'product-card-markup', product: product, media_sizes: media_sizes -%}
          </div>
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..limit) %}
        <div class="f-column{% if type == 'carousel' %} swiper-slide{% endif %}">
          {%- render 'product-card-markup', product: null -%}
        </div>
      {% endfor %}
    {% endif %}
  {%- endcapture -%}

  {%- capture panel_html -%}
    <div
      id="{{ panel_id }}"
      ref="panel[]"
      class="tabs__panel"
      data-index="{{ forloop.index0 }}"
      {{ block.shopify_attributes }}
      {% unless forloop.first %}
        hidden
        data-lazy-loading="true"
      {% endunless %}
    >
      {%- capture tab_panel_content -%}
        {% if type == 'carousel' %}
          <flex-carousel class="featured-collection featured-collection--carousel carousel carousel--grid block {% render 'carousel-class', settings: section.settings %}">
            <script type="application/json" ref="config">
              {
                "slidesPerView": {{ columns_xxl }},
                "slidesPerGroup": {% render 'carousel-slides-per-group' %},
                "spaceBetween": {{ column_gap }},
                "loop": false,
                "autoplay": false,
                "counter": false,
                "loopAddBlankSlides": false,
                "navigationPosition": {
                  "enabled": true,
                  "selector": ".product-card__media"
                },
                "pagination": { "type": "bullets" },
                "mousewheel": {
                  "enabled": true,
                  "forceToAxis": true,
                  "thresholdTime": 300,
                  "thresholdDelta": 10
                },
                "destroyBelow": 768,
                "breakpoints": {
                  "768": {
                    "slidesPerView": {{ columns_md }}
                  },
                  "1024": {
                    "slidesPerView": {{ columns_lg }}
                  },
                  "1200": {
                    "slidesPerView": {{ columns_xl }}
                  },
                  "1440": {
                    "slidesPerView": {{ columns_xxl }}
                  }
                }
              }
            </script>
            <div
              {% if section.settings.carousel_edge_fade_mobile %}is="swipe-component" {% endif %}class="{% render 'carousel-class', settings: section.settings, part: 'viewport-mobile' %}"
            >
             <div class="{% render 'carousel-class', settings: section.settings, part: 'viewport' %}">
              <div
                class="swiper {{ swipe_mobile_classes }}"
                ref="container"
                style="--f-columns-xxl: {{ columns_xxl }};--f-columns-mobile: {{ columns_mobile }}; --f-columns-lg: {{ columns_lg }}; --f-columns-xl: {{ columns_xl }}; --f-columns-md: {{ columns_md }};{% if swipe_custom_width_column %} --swipe-column-width: {{ section.settings.swipe_column_width | divided_by: 100.0 }};{% endif %}"
              >
                <div
                  {% if list_motion != blank %}is="motion-group" {% render 'motion-attributes', type: list_motion, sequence: list_sequence %} {% endif %}
                  class="swiper-wrapper layout-panel-grid-mobile gap-style {{ swipe_mobile_inner_classes }}"
                >
                  {{- list_items -}}
                </div>
              </div>
            </div>
</div>
            {% render 'carousel-controls',
              ref: 'controls',
              settings: section.settings,
              class: 'hidden md:flex'
            %}
          </flex-carousel>
        {% else %}
          <div class="featured-collection featured-collection--grid {{ swipe_mobile_classes }}">
            <div
              {% if list_motion != blank %}is="motion-group" {% render 'motion-attributes', type: list_motion, sequence: list_sequence %} {% endif %}
              class="featured-collection__inner layout-panel-grid gap-style {{ swipe_mobile_inner_classes }}"
            >
              {{- list_items -}}
            </div>
          </div>
        {% endif %}
      {%- endcapture -%}

      {%- unless forloop.first -%}
        <template>{{ tab_panel_content }}</template>
      {%- else -%}
        {{ tab_panel_content }}
      {%- endunless -%}
    </div>
  {%- endcapture -%}

  {%- liquid
    assign tabs_html = tabs_html | append: tab_html
    assign panels_html = panels_html | append: panel_html
  -%}
{%- endfor -%}
<div
  id="section-{{ section.id }}"
  class="section section--featured-collection spacing-style border-style color-{{ section.settings.color_scheme }}"
  style="{{ section_style | strip_newlines | strip }}"
>
  <div
    class="section__container section-grid section-grid--{{ section.settings.container }}"
    style="{{ container_style | strip_newlines | strip }}"
  >
    <tabs-component
      data-section-id="{{ section.id }}"
      data-content-animation="{{ content_animation }}"
      class="section__wrapper block tabs"
    >
      <div class="section__header flex flex-wrap flex-col md:flex-row items-start md:items-center justify-start md:justify-between gap-4">
        {% if heading != blank %}
          {% render 'text-markup',
            fallback_text: heading,
            preset: section.settings.heading_preset,
            font_family: 'var(--font-heading--family)',
            font_size: section.settings.heading_font_size,
            font_size_mobile: section.settings.heading_font_size_mobile,
            line_height: 'tight',
            text_transform: section.settings.heading_text_transform,
            animation_type: section.settings.animation_type,
            animation_split: section.settings.animation_split,
            animation_delay: section.settings.animation_delay
          %}
        {% endif %}
        <div is="swipe-component" class="tabs__header edge__shadows max-w-full">
          <div
            class="tabs__header-inner swipe__element swipe-mobile swipe-mobile--auto-cols"
            ref="tabNav"
          >
            <div
              class="swipe__inner flex flex-wrap md:justify-end gap-2"
              role="tablist"
            >
              {{ tabs_html }}
            </div>
          </div>
        </div>
      </div>
      <div class="tabs__panels">
        {{ panels_html }}
      </div>
    </tabs-component>
  </div>
</div>
{% schema %}
{
  "name": "t:names.product_tab",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:settings.container",
      "options": [
        { "value": "full", "label": "t:options.full" },
        { "value": "fixed", "label": "t:options.fixed" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fixed"
    },
    {
      "type": "range",
      "id": "container_custom_width",
      "label": "t:settings.custom_width",
      "min": 800,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "default": 1240,
      "visible_if": "{{ section.settings.container == 'custom' }}"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_xxl",
      "label": "t:settings.desktop_columns",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.column_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.row_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ section.settings.type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.section_header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "<p>Product tabs</p>"
    },
    {
      "type": "select",
      "id": "heading_highlight_style",
      "label": "t:settings.highlight_style",
      "info": "t:info.highlight_style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "text-color",
          "label": "t:options.text_color"
        },
        {
          "value": "solid-background",
          "label": "t:options.solid_background"
        },
        {
          "value": "badge",
          "label": "t:options.badge"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "heading_highlight_font_style",
      "label": "t:settings.highlight_font_style",
      "options": [
        {
          "value": "italic",
          "label": "t:options.italic"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        }
      ],
      "default": "italic",
      "visible_if": "{{ section.settings.heading_highlight_style != 'none' and section.settings.heading_highlight_style != 'badge' }}"
    },
    {
      "type": "color",
      "id": "heading_highlight_text_color",
      "label": "t:settings.highlight_text_color",
      "visible_if": "{{ section.settings.heading_highlight_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "heading_highlight_shape_color",
      "label": "t:settings.highlight_shape_color",
      "visible_if": "{{ section.settings.heading_highlight_style == 'solid-background' or section.settings.heading_highlight_style == 'badge' }}"
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.font_size",
      "default": 15,
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.heading_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "t:settings.font_size_mobile",
      "default": 15,
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.heading_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "t:settings.text_transform",
      "options": [
        {
          "value": "",
          "label": "t:options.inherit"
        },
        {
          "value": "none",
          "label": "t:options.as_typed"
        },
        {
          "value": "capitalize",
          "label": "t:options.capitalize"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        },
        {
          "value": "lowercase",
          "label": "t:options.lowercase"
        }
      ],
      "default": "",
      "visible_if": "{{ section.settings.heading_preset == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_settings",
      "visible_if": "{{ section.settings.type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_controls",
      "label": "t:settings.control_type",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "dots", "label": "t:options.dots" },
        { "value": "group", "label": "t:options.arrows_dots" },
        { "value": "float", "label": "t:options.float_arrows" },
        { "value": "float_dots", "label": "t:options.float_arrows_dots" }
      ],
      "default": "group",
      "visible_if": "{{ section.settings.type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_alignment",
      "label": "t:settings.control_alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.type == 'carousel' and section.settings.carousel_controls != 'none' }}"
    },
    {
      "type": "select",
      "id": "carousel_overflow",
      "label": "t:settings.overflow_content",
      "options": [
        { "value": "hidden", "label": "t:options.hidden" },
        { "value": "visible", "label": "t:options.visible" }
      ],
      "default": "visible",
      "visible_if": "{{ section.settings.type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_edge_fade",
      "label": "t:settings.show_edge_fade",
      "default": false,
      "visible_if": "{{ section.settings.type == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_on_mobile",
      "label": "t:settings.enable_swipe_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "carousel_edge_fade_mobile",
      "label": "t:settings.show_edge_fade_mobile",
      "default": false,
      "visible_if": "{{ section.settings.type == 'carousel' and section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "checkbox",
      "id": "swipe_custom_width_column",
      "label": "t:settings.swipe_custom_width_column",
      "default": false,
      "visible_if": "{{ section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "swipe_column_width",
      "label": "t:settings.custom_width",
      "min": 20,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 76,
      "visible_if": "{{ section.settings.swipe_custom_width_column == true and section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.grid_1_column"
        },
        {
          "value": "2",
          "label": "t:options.grid_2_column"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.swipe_custom_width_column == false or section.settings.enable_swipe_on_mobile == false }}"
    },
    {
      "type": "range",
      "id": "swipe_rows_mobile",
      "label": "t:settings.swipe_rows",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "visible_if": "{{ section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.swipe_rows_mobile > 1 or section.settings.enable_swipe_on_mobile == false and section.settings.type == 'carousel' or section.settings.type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },

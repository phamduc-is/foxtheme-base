{{ 'scoped-blog-posts.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign blog = section.settings.blog_posts
  assign container = section.settings.container
  assign color_scheme = section.settings.color_scheme
  assign post_limit = section.settings.post_count
  assign columns_xxl = section.settings.columns_xxl
  assign columns_xl = columns_xxl | at_most: 4
  assign columns_lg = columns_xxl | at_most: 3
  assign columns_md = columns_xxl | at_most: 3
  assign enable_swipe_on_mobile = section.settings.enable_swipe_on_mobile
  assign swipe_custom_width_column = section.settings.swipe_custom_width_column
  assign swipe_mobile_classes = ''
  assign swipe_mobile_inner_classes = ''

  if enable_swipe_on_mobile
    assign swipe_mobile_classes = 'swipe-mobile swipe-mobile--1-cols'
    assign swipe_mobile_inner_classes = 'swipe__inner'

    if swipe_custom_width_column
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--custom-width'
    endif
    if section.settings.swipe_rows_mobile > 1
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--rows-' | append: section.settings.swipe_rows_mobile
    endif
  endif

  capture heading
    content_for 'block', type: 'text', id: 'heading'
  endcapture
  capture button
    content_for 'block', type: 'button', id: 'button'
  endcapture

  capture inline_style
    render 'layout-panel-style', type: 'grid', columns_mobile: '1', columns_md: columns_md, columns_lg: columns_lg, columns_xl: columns_xl, columns_xxl: columns_xxl
    render 'gap-style', settings: section.settings
  endcapture

  assign use_padding_inline = true
  if section.settings.container != 'full'
    assign use_padding_inline = false
  endif
-%}
{%- liquid
  assign sizes_page_width = settings.page_width
  if section.settings.container == 'custom'
    assign sizes_page_width = section.settings.container_custom_width
  endif
-%}
{%- capture image_sizes -%}
  (min-width: 1440px) calc( min(100vw, {{ sizes_page_width }}px) / {{ columns_xxl }} ),
  (min-width: 1200px) calc( min(100vw, {{ sizes_page_width }}px) / {{ columns_xl }} ),
  (min-width: 1024px) calc( {{ sizes_page_width }}px / {{ columns_lg }} ),
  (min-width: 768px) calc( {{ sizes_page_width }}px / {{ columns_md }} ),
  calc(100vw - 32px)
{%- endcapture -%}

{% capture section_style %}
  {% render 'spacing-style', settings: section.settings, use_padding_inline: use_padding_inline %}
  {% render 'border-style', settings: section.settings %}

  {% if swipe_custom_width_column %}
    --swipe-column-width: {{ section.settings.swipe_column_width | divided_by: 100.0 }};
  {% endif %}
{% endcapture %}

<div
  id="section-{{ section.id }}"
  class="blog-posts blog-posts--grid spacing-style color-{{ color_scheme }} border-style"
  style="{{ section_style | strip | strip_newlines }}"
>
  <div class="section__container section-grid section-grid--{{ container }}"{% if container == 'custom' %} style="--page-width-custom: {{ section.settings.container_custom_width | divided_by: 10.0 }}rem;"{% endif %}>
    <div class="blog-posts__wrapper">
      <div class="blog-posts__grid text-center">
        {{ heading }}
        <div
          class="blog-posts__content {{ swipe_mobile_classes }}"
        >
          <div
            class="layout-panel-grid gap-style {{ swipe_mobile_inner_classes }}"
            style="{{ inline_style | strip | strip_newlines }}"
          >
            {% if blog and blog.articles_count > 0 %}
              {% for article in blog.articles limit: post_limit %}
                <div class="f-column relative">
                  {% content_for 'block', type: '_article-card', id: 'article-card', article: article, image_sizes: image_sizes, layout: 'column' %}
                </div>
              {% endfor %}
            {% else %}
              {% for i in (1..post_limit) %}
                <div class="f-column relative">
                  {% # theme-check-disable %}
                  {% content_for 'block', type: '_article-card', id: 'article-card', article: article, layout: 'column' %}
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
        {{ button }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.main_blog",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog_posts",
      "label": "t:names.blog"
    },
    {
      "type": "header",
      "content": "t:names.layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:settings.container",
      "options": [
        {
          "value": "fixed",
          "label": "t:options.fixed"
        },
        {
          "value": "full",
          "label": "t:options.full"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "range",
      "id": "container_custom_width",
      "label": "t:settings.custom_width",
      "min": 800,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "default": 1240,
      "visible_if": "{{ section.settings.container == 'custom' }}"
    },
    {
      "type": "range",
      "id": "post_count",
      "label": "t:settings.post_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_xxl",
      "label": "t:settings.desktop_columns",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_on_mobile",
      "label": "t:settings.enable_swipe_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "swipe_custom_width_column",
      "label": "t:settings.swipe_custom_width_column",
      "default": false,
      "visible_if": "{{ section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "swipe_column_width",
      "label": "t:settings.custom_width",
      "min": 20,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 76,
      "visible_if": "{{ section.settings.swipe_custom_width_column == true and section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "swipe_rows_mobile",
      "label": "t:settings.swipe_rows",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "visible_if": "{{ section.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:settings.border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:settings.devices",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50,
      "visible_if": "{{ section.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.device == 'desktop' and section.settings.container == 'full' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.device == 'desktop' and section.settings.container == 'full' }}"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.device == 'mobile' and section.settings.container == 'full' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.device == 'mobile' and section.settings.container == 'full' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.blog_posts_grid",
      "category": "t:categories.storytelling",
      "settings": {
        "post_count": 3,
        "columns_xxl": 3,
        "column_gap": 30,
        "row_gap": 30,
        "enable_swipe_on_mobile": true,
        "column_gap_mobile": 8
      },
      "blocks": {
        "heading": {
          "type": "text",
          "static": true,
          "name": "t:names.heading",
          "settings": {
            "animation_type": "fade-up",
            "animation_split": "words",
            "text": "<p>Talking about your brand</p>",
            "type_preset": "h1",
            "width": "100%",
            "width_mobile": "100%",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "padding-block-end": 40,
            "mobile-padding-scale": 60
          }
        },
        "button": {
          "type": "button",
          "static": true,
          "name": "t:names.button",
          "settings": {
            "label": "Button label",
            "link": "",
            "style": "primary",
            "size": "large",
            "icon": "caret-right"
          }
        },
        "article-card": {
          "type": "_article-card",
          "static": true,
          "blocks": {
            "article-card-tag": {
              "type": "_article-card-tag",
              "name": "t:names.tag",
              "static": true,
              "settings": {
                "placement": "media"
              }
            },
            "article-card-title": {
              "type": "_article-card-title",
              "name": "t:names.title",
              "static": true,
              "settings": {
                "type_preset": "h4"
              }
            },
            "article-card-meta": {
              "type": "_article-card-meta",
              "name": "t:names.meta",
              "static": true,
              "settings": {
                "show_date": true,
                "show_author": true
              }
            }
          }
        }
      }
    }
  ]
}
{% endschema %}

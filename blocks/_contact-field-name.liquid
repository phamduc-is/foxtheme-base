{% doc %}
  Static "Name" field for the contact form. Rendered by `blocks/contact-form.liquid`
  via `content_for 'block'` from INSIDE its `{% form 'contact' %}` tag, so the
  field posts as part of that form and `form.name` resolves here.

  @param {string} [parent_id] - Unique id of the hosting contact-form block. A
  static child's own block.id is the literal static id — identical for every
  form instance — so two contact forms on one page would collide without it.

  @example
  {% content_for 'block', type: '_contact-field-name', id: 'contact-field-name', parent_id: block.id %}
{% enddoc %}

{%- liquid
  assign uid = parent_id | default: block.id
  assign field_id = 'ContactForm-name-' | append: uid
  assign label = 'blocks.contact_form.name' | t

  assign width_class = ''
  if block.settings.width == 'full'
    assign width_class = ' form-field--full'
  endif
  if block.settings.width_mobile == 'half'
    assign width_class = width_class | append: ' form-field--half-mobile'
  endif
-%}

<div
  class="form-field form-field--name{{ width_class }}"
  {{ block.shopify_attributes }}
>
  <label class="form-label" for="{{ field_id }}">
    {{- label -}}
  </label>
  <input
    class="form-control w-full"
    autocomplete="name"
    type="text"
    id="{{ field_id }}"
    name="contact[{{ label }}]"
    {% if block.settings.placeholder != blank %}
      placeholder="{{ block.settings.placeholder }}"
    {% endif %}
    {% # theme-check-disable %}
    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
    {% # theme-check-enable %}
  >
</div>

{% schema %}
{
  "name": "t:names.contact_field_name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:settings.placeholder"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "full",
          "label": "t:options.full"
        },
        {
          "value": "half",
          "label": "t:options.one_half"
        }
      ],
      "default": "half"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "full",
          "label": "t:options.full"
        },
        {
          "value": "half",
          "label": "t:options.one_half"
        }
      ],
      "default": "full"
    }
  ]
}
{% endschema %}

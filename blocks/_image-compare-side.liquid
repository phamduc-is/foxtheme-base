{%- doc -%}
  Before/After image

  @param {boolean} [is_before] - Whether the block is before image
  @param {string} [heading_style] - Heading style from the parent: 'badge' (default) | 'text' (plain label over a scrim)
  @param {string} [svg_placeholder] - Svg for placeholder
  @param {string} [image_ratio] - Aspect ratio for image
  @param {string} [image_ratio_mobile] - Aspect ratio for image on mobile

  @example
  {% content_for 'block', type: '_image-compare-side', id: 'image-comparison-image', is_before: true %}
{%- enddoc -%}
{%- liquid
  assign heading = block.settings.heading
  assign svg_placeholder = svg_placeholder | default: 'lifestyle-1'

  # Both halves of the comparison are on screen at once; in an early section that is
  # above the fold, so eager/high makes responsive-image render liquid mode (preload
  # scanner) instead of waiting for the deferred bundle.
  capture priority
    render 'image-priority', section: section, preload: block.settings.enable_preload_image
  endcapture
  assign priority = priority | split: ','
  assign loading = priority[0]
  assign fetchpriority = priority[1]
-%}
<div
  class="image-comparison__image image-comparison__image-{% if is_before %}before{% else %}after{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if heading != blank -%}
    {%- if heading_style == 'text' -%}
      <span class="image-comparison__scrim absolute z-1" aria-hidden="true"></span>
    {%- endif -%}
    <p class="image-comparison__heading{% unless heading_style == 'text' %} badge{% endunless %} flex m-0 absolute z-1">
      {{ heading }}
    </p>
  {%- endif -%}
  {% render 'responsive-image',
    mode: 'js',
    image: block.settings.image,
    image_mobile: block.settings.image_mobile,
    svg_placeholder: svg_placeholder,
    loading: loading,
    fetchpriority: fetchpriority,
    image_ratio: image_ratio,
    image_ratio_mobile: image_ratio_mobile
  %}
</div>
{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "label": "t:settings.image",
      "id": "image"
    },
    {
      "type": "image_picker",
      "label": "t:settings.image_mobile",
      "id": "image_mobile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "checkbox",
      "id": "enable_preload_image",
      "label": "t:settings.enable_preload_image",
      "info": "t:info.enable_preload_image"
    }
  ]
}
{% endschema %}

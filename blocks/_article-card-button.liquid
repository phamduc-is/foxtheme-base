{% doc %}
  Article card button. Dynamic block exposing the full Button settings EXCEPT label and link.
  The CTA label is owned by the card (fixed `blogs.article.article_button_label`) and the link is
  the article URL — read from `closest.article` (injected by the card via `content_for 'blocks'`),
  falling back to a passed-in `article` on the card's static default path. The merchant controls
  the button's appearance.
{% enddoc %}
{%- liquid
  assign article = article | default: closest.article
  assign button_label = 'blogs.article.article_button_label' | t
-%}
{% render 'button-markup',
  wrapper_class: 'article-card__button',
  button_class: button_class,
  label: button_label,
  link: article.url,
  style: block.settings.style,
  size: block.settings.size,
  icon: block.settings.icon,
  icon_size: block.settings.icon_size,
  icon_only: block.settings.icon_only,
  icon_end: block.settings.icon_end,
  width: block.settings.width,
  width_mobile: block.settings.width_mobile,
  block: block
%}

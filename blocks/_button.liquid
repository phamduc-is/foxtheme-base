{% doc %}
  Button theme block. All visual options come from `block.settings` (the merchant
  configures them in the editor). The params below are NOT block settings — they
  are passed by the PARENT when rendering this block as a static block, to scope
  it inside a parent layout/style.

  @param {string} [wrapper_class] - Extra class(es) added to the button wrapper, e.g. to position/size the button within the parent
  @param {string} [button_class] - Extra class(es) added to the `<button>`/`<a>` element itself

  @example
  {% # Static block rendered from a parent section/block %}
  {% content_for 'block', type: '_button', id: 'button', wrapper_class: 'image-card__button' %}
{% enddoc %}
{% render 'button-markup',
  wrapper_class: wrapper_class,
  button_class: button_class,
  label: block.settings.label,
  link: block.settings.link,
  style: block.settings.style,
  size: block.settings.size,
  icon: block.settings.icon,
  icon_only: block.settings.icon_only,
  icon_end: block.settings.icon_end,
  icon_size: block.settings.icon_size,
  width: block.settings.width,
  width_mobile: block.settings.width_mobile,
  block: block
%}

{% doc %}
  Icon box theme block. Visual options come from `block.settings`; the icon and
  the text content are static child blocks — a `_icon` block plus two
  `_text-plain` blocks (`heading` + `body`) the merchant edits in place.
{% enddoc %}
{%- liquid
  capture icon_html
    content_for 'block', type: '_icon', id: 'icon'
  endcapture
  # Captured apart so the link caret can be placed inline beside the heading.
  capture heading_html
    content_for 'block', type: '_text-plain', id: 'heading', text_class: 'icon-box__heading'
  endcapture
  capture description_html
    content_for 'block', type: '_text-plain', id: 'description', text_class: 'icon-box__description'
  endcapture

  # Card padding is merchant-driven; emit the spacing-style vars the card CSS reads.
  assign padding_style = ''
  if block.settings.style == 'card'
    capture padding_style
      render 'spacing-style', settings: block.settings
    endcapture
  endif
-%}
{% render 'icon-box-markup',
  icon_html: icon_html,
  heading_html: heading_html,
  description_html: description_html,
  padding_style: padding_style,
  shopify_attributes: block.shopify_attributes,
  content_direction: block.settings.content_direction,
  horizontal_alignment: block.settings.horizontal_alignment,
  vertical_alignment: block.settings.vertical_alignment,
  content_direction_mobile: block.settings.content_direction_mobile,
  horizontal_alignment_mobile: block.settings.horizontal_alignment_mobile,
  vertical_alignment_mobile: block.settings.vertical_alignment_mobile,
  column_gap: block.settings.column_gap,
  row_gap: block.settings.row_gap,
  column_gap_mobile: block.settings.column_gap_mobile,
  row_gap_mobile: block.settings.row_gap_mobile,
  content_row_gap: block.settings.content_row_gap,
  link: block.settings.link,
  show_link_icon: block.settings.show_link_icon,
  link_icon: block.settings.link_icon,
  link_icon_position: block.settings.link_icon_position,
  link_icon_style: block.settings.link_icon_style,
  link_icon_color: block.settings.link_icon_color,
  link_icon_size: block.settings.link_icon_size,
  style: block.settings.style,
  inherit_color_scheme: block.settings.inherit_color_scheme,
  color_scheme: block.settings.color_scheme,
  border: block.settings.border,
  border_width: block.settings.border_width,
  border_opacity: block.settings.border_opacity,
  border_color: block.settings.border_color,
  border_hover: block.settings.border_hover,
  border_color_hover: block.settings.border_color_hover,
  border_radius: block.settings.border_radius
%}

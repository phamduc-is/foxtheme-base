{% doc %}
  One answer card of a Finder quiz question (dynamic, whitelisted by `_finder-quiz-question`).

  A thin wrapper: all markup lives in `snippets/product-quiz-option-markup.liquid`. This block adds
  the Finder matching data: the store-filter value the card selects (`filter_value`). A card whose
  value matches no product in the current cascade is hidden by the runtime.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- liquid
  assign filter_value = block.settings.filter_value | strip
  comment
    `title` is inline richtext (HTML). A title with no visible text falls back to the filter
    value, escaped so the snippet can treat both as HTML.
  endcomment
  assign title = block.settings.title
  assign title_check = title | strip_html | strip
  if title_check == blank
    assign title = filter_value | escape
  endif
-%}
{%- render 'product-quiz-option-markup', block: block, matching: 'filter', title: title, filter_value: filter_value -%}


{%- liquid
  assign collection_list = block.settings.collection_list
  assign limit = 8
  # The carousel is per-tab but the controls are a section-wide design call, so the shared
  # `carousel_*` settings live on the section and this block reads up.
  assign enable_swipe_on_mobile = section.settings.enable_swipe_on_mobile
  assign swipe_custom_width_column = section.settings.swipe_custom_width_column
  assign column_gap = section.settings.column_gap
  assign columns_xxl = section.settings.columns
  assign columns_xl = columns_xxl | at_most: 4
  assign columns_lg = columns_xxl | at_most: 3
  assign columns_md = columns_xxl | at_most: 3
  assign columns_mobile = section.settings.columns_mobile | plus: 0

  # The entrance is a section-wide design call like the carousel settings above,
  # so this reads up the same way. Every animated option lands on the list
  # rather than on the panel: a motion-group also animates on scroll-into-view,
  # which a panel-level entrance cannot, since nothing switches tabs on first
  # load.
  #
  # Every value except 'none' IS a preset name, so it passes straight through
  # rather than being listed here — adding an entrance to the select is then a
  # schema change and nothing else. motion-group validates the name against the
  # registry and falls back to its default, so a typo degrades instead of
  # leaving the list hidden.
  #
  # 'stagger' is the retired value: it used to mean fade-up AND one-by-one,
  # because the effect and its rhythm shared one select. They are two settings
  # now, so a stored 'stagger' maps to what it always meant.
  assign list_motion = ''
  assign list_sequence = false
  if settings.animations_enabled
    if section.settings.content_animation == 'stagger'
      assign list_motion = 'fade-up'
      assign list_sequence = true
    elsif section.settings.content_animation != 'none' and section.settings.content_animation != blank
      assign list_motion = section.settings.content_animation
      # Normalised to a real boolean rather than passed through: a section saved
      # before this setting existed reads nil here, and the snippet treats nil as
      # "caller said nothing" — which would sequence a list the merchant never
      # asked to sequence.
      if section.settings.content_animation_sequence
        assign list_sequence = true
      endif
    endif
  endif

  if section.settings.custom_columns != blank
    assign custom_columns_array = section.settings.custom_columns | split: ','
    for custom_column in custom_columns_array
      assign pair = custom_column | strip
      if pair == ''
        continue
      endif

      assign custom_column_key = pair | split: ':' | first | strip
      assign value_str = pair | split: ':' | last | strip
      if value_str == ''
        continue
      endif
      assign custom_column_value = value_str | plus: 0

      comment
        Guard on the NUMBER: `split` drops a trailing empty field, so `"md:"` yields
        `"md"` from `| last` — past the `value_str == ''` guard — and `| plus: 0` makes
        it 0, collapsing that breakpoint to one column. See snippets/grid-markup.liquid.
      endcomment
      if custom_column_value < 1
        continue
      endif

      case custom_column_key
        when 'mb'
          assign columns_mobile = custom_column_value
        when 'md'
          assign columns_md = custom_column_value
        when 'lg'
          assign columns_lg = custom_column_value
        when 'xl'
          assign columns_xl = custom_column_value
        when 'xxl'
          assign columns_xxl = custom_column_value
      endcase
    endfor
  endif

  assign swipe_mobile_classes = ''
  assign swipe_mobile_inner_classes = ''

  if enable_swipe_on_mobile
    assign swipe_mobile_classes = 'swipe__element swipe-mobile swipe-mobile--[columns]-cols' | replace: '[columns]', columns_mobile
    assign swipe_mobile_inner_classes = 'swipe__inner'

    if swipe_custom_width_column
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--custom-width'
    endif
    if section.settings.swipe_rows_mobile > 1
      assign swipe_mobile_classes = swipe_mobile_classes | append: ' swipe-mobile--rows-' | append: section.settings.swipe_rows_mobile
    endif
  endif

  assign block_index = section.blocks | find_index: 'id', block.id

  assign tab_title = block.settings.tab_name | default: 'Tab'

  # Rendered, not left to the runtime — see blocks/_tab.liquid for why.
  assign is_active = false
  if block_index == 0
    assign is_active = true
  endif
-%}
{%- capture panel_id -%}{{ section.id }}-panel-{{ block_index }}{%- endcapture -%}

{%- liquid
  assign sizes_page_width = settings.page_width
  if section.settings.container == 'custom'
    assign sizes_page_width = section.settings.container_custom_width
  endif
-%}
{%- capture image_sizes -%}
  {%- capture container_width -%}
    {%- if section.settings.container == 'full' -%}100vw{%- else -%}(min(100vw, {{ sizes_page_width | plus: 32 }}px) - 32px){%- endif -%}
  {%- endcapture -%}
  (min-width: 1440px) calc({{ container_width }} / {{ columns_xxl }}), (min-width: 1200px) calc({{ container_width }} / {{ columns_xl }}), (min-width: 1024px) calc({{ container_width }} / {{ columns_lg }}), (min-width: 768px) calc({{ container_width }} / {{ columns_md }}), calc((100vw - 32px) / {{ columns_mobile }})
{%- endcapture -%}

{% capture list_items %}
  {% if collection_list != blank %}
    {% for collection in collection_list %}
      <div class="f-column{% if section.settings.type == 'carousel' %} swiper-slide{% endif %}">
        {% # theme-check-disable %}
          {% render 'collection-card-markup', render_with_shell: false, collection: collection, section: section, image_sizes: image_sizes, text_alignment: section.settings.text_alignment, show_product_count: section.settings.show_product_count, attributes: block.shopify_attributes %}
        {% # theme-check-enable %}
      </div>
    {% endfor %}
  {% else %}
    {% for i in (1..limit) %}
      <div class="f-column{% if section.settings.type == 'carousel' %} swiper-slide{% endif %}">
        {% # theme-check-disable %}
          {% render 'collection-card-markup', render_with_shell: false, collection: null, section: section, text_alignment: section.settings.text_alignment, show_product_count: section.settings.show_product_count, attributes: block.shopify_attributes %}
        {% # theme-check-enable %}
      </div>
    {% endfor %}
  {% endif %}
{% endcapture %}

<!-- @collectionTabs/split -->
<a
  href="#{{ panel_id }}"
  aria-controls="{{ panel_id }}"
  ref="tab[]"
  on:click="/onTabClick"
  on:keydown="/onKeydown"
  role="tab"
  aria-selected="{{ is_active }}"
  tabindex="{% if is_active %}0{% else %}-1{% endif %}"
  class="tabs__button inline-flex items-center justify-center relative rounded"
  data-index="{{ block_index }}"
>
  <span class="tabs__button-text relative text-ellipsis" data-label="{{ tab_title | escape }}">{{ tab_title }}</span>
</a>
<!-- @collectionTabs/split -->
<div
  id="{{ panel_id }}"
  ref="panel[]"
  class="tabs__panel"
  {% if block_index != 0 %}
    hidden
    data-lazy-loading="true"
  {% endif %}
  data-index="{{ block_index }}"
  {{ block.shopify_attributes }}
>
  {%- capture tab_panel_content -%}
    {% if section.settings.type == 'carousel' %}
      <flex-carousel class="collection-list__wrapper block collection-list--carousel carousel carousel--grid {% render 'carousel-class', settings: section.settings %}">
        <script type="application/json" ref="config">
          {
            "loop": false,
            "slidesPerView": {{ columns_md }},
            "slidesPerGroup": {% render 'carousel-slides-per-group' %},
            "spaceBetween": {{ column_gap }},
            "mousewheel": {
              "enabled": true,
              "forceToAxis": true,
              "thresholdTime": 300,
              "thresholdDelta": 10
            },
            "navigationPosition": {
              "enabled": true,
              "selector": ".media .media__image"
            },
            "pagination": { "type": "bullets" },
            "destroyBelow": 768,
            "counter": false,
            "breakpoints": {
              "768": {
                "slidesPerView": {{ columns_md }}
              },
              "1024": {
                "slidesPerView": {{ columns_lg }}
              },
              "1200": {
                "slidesPerView": {{ columns_xl }}
              },
              "1440": {
                "slidesPerView": {{ columns_xxl }}
              }
            }
          }
        </script>
        <div
          {% if section.settings.carousel_edge_fade_mobile %}is="swipe-component" {% endif %}class="{% render 'carousel-class', settings: section.settings, part: 'viewport-mobile' %}"
        >
         <div class="{% render 'carousel-class', settings: section.settings, part: 'viewport' %}">
          <div
            class="swiper {{ swipe_mobile_classes }}"
            ref="container"
            style="--f-columns-xxl: {{ columns_xxl }};--f-columns-mobile: {{ columns_mobile }}; --f-columns-lg: {{ columns_lg }}; --f-columns-xl: {{ columns_xl }}; --f-columns-md: {{ columns_md }};"
          >
            <div
              {% if list_motion != blank %}is="motion-group" {% render 'motion-attributes', type: list_motion, sequence: list_sequence %} {% endif %}
              class="swiper-wrapper layout-panel-grid-mobile gap-style {{ swipe_mobile_inner_classes }}"
            >
              {{- list_items -}}
            </div>
          </div>
        </div>
</div>
        {% render 'carousel-controls', ref: 'controls', settings: section.settings, class: 'hidden md:flex' %}
      </flex-carousel>
    {% else %}
      <div class="collection-list__wrapper collection-list--grid {{ swipe_mobile_classes }}">
        <div
          {% if list_motion != blank %}is="motion-group" {% render 'motion-attributes', type: list_motion, sequence: list_sequence %} {% endif %}
          class="collection-list__inner layout-panel-grid gap-style {{ swipe_mobile_inner_classes }}"
        >
          {{- list_items -}}
        </div>
      </div>
    {% endif %}
  {%- endcapture -%}

  {%- unless block_index == 0 -%}
    <template>{{ tab_panel_content }}</template>
  {%- else -%}
    {{ tab_panel_content }}
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "t:categories.collections",
  "tag": null,
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:settings.collections"
    },
    {
      "type": "text",
      "id": "tab_name",
      "label": "t:settings.tab_name"
    }
  ],
  "presets": [
    {
      "name": "t:categories.collections"
    }
  ]
}
{% endschema %}

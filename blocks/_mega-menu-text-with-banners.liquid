{% doc %}
  Private header mega-menu block: text-with-banners layout (links + text column + images).
{% enddoc %}
{%- liquid
  assign menu_item_handle = block.settings.menu_title | downcase | handle

  assign link = blank
  for top_link in section.settings.menu.links
    assign top_link_handle = top_link.title | downcase | handle
    if top_link_handle == menu_item_handle
      assign link = top_link
      break
    endif
  endfor

  assign menu_mobile = section.settings.menu_mobile | default: section.settings.menu
  assign mobile_link = blank
  for top_link in menu_mobile.links
    assign top_link_handle = top_link.title | downcase | handle
    if top_link_handle == menu_item_handle
      assign mobile_link = top_link
      break
    endif
  endfor

  assign menu_columns = block.settings.menu_columns
  assign promotions_width = block.settings.promotions_width
  assign inline_style = ''
  assign has_banners = false
  assign has_rich_content = false

  if block.blocks.size > 0
    assign has_banners = true
  endif

  assign column_heading = block.settings.column_heading
  if block.settings.column_heading_highlight_style != 'none'
    capture column_heading
      render 'highlight-text', text: block.settings.column_heading, style: block.settings.column_heading_highlight_style, font_style: block.settings.column_heading_highlight_font_style, text_color: block.settings.column_heading_highlight_text_color, shape_color: block.settings.column_heading_highlight_shape_color
    endcapture
  endif

  if block.settings.column_heading != blank or block.settings.column_text != blank
    assign has_rich_content = true
  endif

  if has_banners or has_rich_content
    assign mega_menu_css_class = 'mega-menu--rich mega-menu--reverse-column'
    assign mega_menu_wrapper_class = 'flex-row-reverse'
  endif

  if link.links != blank
    assign mega_menu_css_class = mega_menu_css_class | append: ' mega-menu--with-links'
  else
    assign mega_menu_css_class = mega_menu_css_class | append: ' mega-menu--no-links'
  endif
-%}
{%- capture children -%}{% content_for 'blocks' %}{%- endcapture -%}
<!-- @megaMenu/context/desktop -->
<details
  id="Mega-menu-item-{{ block.id }}"
  is="details-mega"
  trigger="{{ section.settings.menu_trigger }}"
  level="top"
  style="--menu-columns: {{ menu_columns }}; --promotions-width: {{ promotions_width }}%;"
  {{ block.shopify_attributes }}
>
  <summary data-link="{{ link.url }}">
    <span class="menu__item reversed-link">
      <span class="reversed-link__text">{{- link.title | escape -}}</span>
      {%- render 'icon', icon: 'caret-down', size: 'extra-small' -%}
    </span>
  </summary>
  <div class="mega-menu mega-menu--text-with-banners{% if mega_menu_css_class != blank %} {{ mega_menu_css_class }}{% endif %} flex flex-col">
    <div class="mega-menu__container v-scrollable{% unless settings.dialog_color_scheme_inherit %} color-{{ settings.dialog_color_scheme }}{% endunless %}">
      <div
        data-mega-menu-wrapper
        class="page-width mega-menu__wrapper flex flex-wrap {{ mega_menu_wrapper_class }}"
      >
        {%- if link.links != blank -%}
          <div class="mega-menu__list">
            <div class="mega-menu__column">
              <ul class="mega-menu__item-child list-unstyled color-subtext">
                {%- for childlink in link.links -%}
                  <li>
                    <a
                      class="block mega-menu__link text-decoration-none reversed-link color-current"
                      href="{{ childlink.url }}"
                    >
                      <span class="reversed-link__text">
                        {{- childlink.title | escape -}}
                      </span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}
        {%- if has_banners or has_rich_content -%}
          <div class="mega-menu__promotions flex">
            {%- if has_rich_content -%}
              <div
                class="mega-menu__promotions-text flex flex-col gap-4 shrink-0"
                style="{{ inline_style }}"
              >
                {%- if block.settings.column_heading -%}
                  {% render 'text-markup', fallback_text: column_heading, preset: block.settings.column_heading_size %}
                {%- endif -%}
                {%- if block.settings.column_text -%}
                  {% render 'text-markup', fallback_text: block.settings.column_text, preset: 'rte', text_color: 'subtext' %}
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if has_banners -%}
              {%- liquid
                assign columns_desktop = block.settings.columns_desktop
                assign columns_mobile = block.settings.columns_mobile | times: 1
              -%}
              {% capture inline_style %}
                {% render 'layout-panel-style', type: 'grid', columns_mobile: columns_mobile, columns_xxl: columns_desktop %}
                {% render 'gap-style', column_gap: 30, column_gap_mobile: 12, row_gap: 30, row_gap_mobile: 12 %}
              {% endcapture %}
              <div
                class="mega-menu__promotions-banners flex-grow layout-panel-grid gap-style"
                style="{{ inline_style }}"
              >
                {{ children }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</details>
<!-- @megaMenu/context/mobile -->
{%- if mobile_link != blank -%}
  {%- capture details_content_html -%}
    {%- if mobile_link.links != blank or has_rich_content -%}
      <div class="menu-drawer__nav flex flex-col gap-5">
        {%- if has_rich_content -%}
          <div class="menu-drawer__mega flex flex-col gap-3">
            {%- if block.settings.column_heading -%}
              {% render 'text-markup', fallback_text: column_heading, preset: block.settings.column_heading_size %}
            {%- endif -%}
            {%- if block.settings.column_text -%}
              {% render 'text-markup', fallback_text: block.settings.column_text, preset: 'rte', text_color: 'subtext' %}
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- render 'menu-drawer-sublinks', link: mobile_link, style: 'links-only' -%}
      </div>
    {%- endif -%}
    {%- if has_banners -%}
      {%- liquid
        assign columns_mobile = block.settings.columns_mobile | times: 1
      -%}
      {%- capture drawer_banner_style -%}
        {% render 'layout-panel-style', type: 'grid', columns_mobile: columns_mobile %}
        {% render 'gap-style', column_gap: 30, column_gap_mobile: 12, row_gap: 30, row_gap_mobile: 12 %}
      {%- endcapture -%}
      <div class="menu-drawer__mega">
        <div
          class="mega-menu__promotions-banners flex-grow layout-panel-grid gap-style"
          style="{{ drawer_banner_style }}"
        >
          {{ children }}
        </div>
      </div>
    {%- endif -%}
  {%- endcapture -%}
  {%- render 'menu-drawer-details', link: mobile_link, content: details_content_html, content_class: 'menu-drawer__submenu--text-with-banners' -%}
{%- endif -%}
<!-- @megaMenu/handle/{{ menu_item_handle }} -->
<!-- @megaMenu/split -->
{% schema %}
{
  "name": "t:names.text_with_banners",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "label": "t:settings.menu_title",
      "id": "menu_title"
    },
    {
      "type": "header",
      "content": "t:content.text_with_banners"
    },
    {
      "type": "range",
      "id": "promotions_width",
      "label": "t:settings.width",
      "info": "t:info.promotions_width",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 78
    },
    {
      "type": "header",
      "content": "t:settings.text_column"
    },
    {
      "type": "inline_richtext",
      "id": "column_heading",
      "label": "t:settings.heading",
      "default": "Talk about your brand"
    },
    {
      "type": "select",
      "id": "column_heading_highlight_style",
      "label": "t:settings.highlight_style",
      "info": "t:info.highlight_style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "text-color",
          "label": "t:options.text_color"
        },
        {
          "value": "solid-background",
          "label": "t:options.solid_background"
        },
        {
          "value": "badge",
          "label": "t:options.badge"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "column_heading_highlight_font_style",
      "label": "t:settings.highlight_font_style",
      "options": [
        {
          "value": "italic",
          "label": "t:options.italic"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        }
      ],
      "default": "italic",
      "visible_if": "{{ block.settings.column_heading_highlight_style != 'none' and block.settings.column_heading_highlight_style != 'badge' }}"
    },
    {
      "type": "color",
      "id": "column_heading_highlight_text_color",
      "label": "t:settings.highlight_text_color",
      "visible_if": "{{ block.settings.column_heading_highlight_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "column_heading_highlight_shape_color",
      "label": "t:settings.highlight_shape_color",
      "visible_if": "{{ block.settings.column_heading_highlight_style == 'solid-background' or block.settings.column_heading_highlight_style == 'badge' }}"
    },
    {
      "type": "select",
      "id": "column_heading_size",
      "label": "t:settings.heading_size",
      "default": "h5",
      "options": [
        {
          "label": "t:options.h6",
          "value": "h6"
        },
        {
          "label": "t:options.h5",
          "value": "h5"
        },
        {
          "label": "t:options.h4",
          "value": "h4"
        },
        {
          "label": "t:options.h3",
          "value": "h3"
        },
        {
          "label": "t:options.h2",
          "value": "h2"
        },
        {
          "label": "t:options.h1",
          "value": "h1"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "column_text",
      "label": "t:settings.text",
      "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
    },
    {
      "type": "header",
      "content": "t:content.banners"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.desktop_columns",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.grid_1_column"
        },
        {
          "value": "2",
          "label": "t:options.grid_2_column"
        }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "image-card"
    }
  ],
  "presets": [
    {
      "name": "t:names.text_with_banners"
    }
  ]
}
{% endschema %}

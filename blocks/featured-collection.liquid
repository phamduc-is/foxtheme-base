{%- liquid
  assign collection = block.settings.collection
  assign limit = block.settings.product_count
  assign type = block.settings.type
  assign columns_xxl = block.settings.columns_xxl
  assign columns_xl = columns_xxl | at_most: 4
  assign columns_lg = columns_xxl | at_most: 3
  assign columns_md = columns_xxl | at_most: 3
  assign columns_mobile = block.settings.columns_mobile | plus: 0
-%}

{%- capture list_items -%}
  {%- if collection != blank and shop.products_count != 0 -%}
    {%- liquid
      assign width = 100
      if block.settings.width == 'custom'
        assign width = block.settings.custom_width
      endif

      assign width_mobile = 100
      if block.settings.width_mobile == 'custom'
        assign width_mobile = block.settings.custom_width_mobile
      endif

      assign width_ratio = width | divided_by: 100.0
      assign width_ratio_mobile = width_mobile | divided_by: 100.0
    -%}
    {%- capture media_sizes -%}
      {%- capture container_size -%}(min(100vw, {{ settings.page_width | plus: 32 }}px) - 32px){%- endcapture -%}
      (min-width: 1440px) calc({{ container_size }} * {{ width_ratio }} / {{ columns_xxl }}), (min-width: 1200px) calc({{ container_size }} * {{ width_ratio }} / {{ columns_xl }}), (min-width: 1024px) calc({{ container_size }} * {{ width_ratio }} / {{ columns_lg }}), (min-width: 768px) calc({{ container_size }} * {{ width_ratio }} / {{ columns_md }}), calc((100vw - 32px) * {{ width_ratio_mobile }} / {{ columns_mobile }})
    {%- endcapture -%}
    {%- paginate collection.products by limit -%}
      {%- for product in collection.products limit: limit -%}
        <div class="f-column{% if type == 'carousel' %} swiper-slide{% endif %}">
          {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', product: product, media_sizes: media_sizes %}
          {% # theme-check-enable %}
        </div>
      {%- endfor -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- for i in (1..limit) -%}
      <div class="f-column{% if type == 'carousel' %} swiper-slide{% endif %}">
        {% # theme-check-disable %}
          {% content_for 'block', type: '_product-card', id: 'static-product-card', product: null %}
        {% # theme-check-enable %}
      </div>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{% render 'featured-collection-markup',
  block_settings: block.settings,
  attributes: block.shopify_attributes,
  list_items: list_items
%}
{% schema %}
{
  "name": "t:names.featured_collection",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns_xxl",
      "label": "t:settings.desktop_columns",
      "default": 3,
      "min": 2,
      "max": 4,
      "step": 1
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ block.settings.type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_settings",
      "visible_if": "{{ block.settings.type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_position",
      "label": "t:settings.control_position",
      "options": [
        { "value": "header", "label": "t:options.controls_in_header" },
        { "value": "below", "label": "t:options.controls_below" }
      ],
      "default": "header",
      "visible_if": "{{ block.settings.type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carousel_controls",
      "label": "t:settings.control_type",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "dots", "label": "t:options.dots" },
        { "value": "group", "label": "t:options.arrows_dots" },
        { "value": "float", "label": "t:options.float_arrows" },
        { "value": "float_dots", "label": "t:options.float_arrows_dots" }
      ],
      "default": "group",
      "visible_if": "{{ block.settings.type == 'carousel' and block.settings.carousel_controls_position == 'below' }}"
    },
    {
      "type": "select",
      "id": "carousel_controls_alignment",
      "label": "t:settings.control_alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start",
      "visible_if": "{{ block.settings.type == 'carousel' and block.settings.carousel_controls_position == 'below' and block.settings.carousel_controls != 'none' }}"
    },
    {
      "type": "select",
      "id": "carousel_overflow",
      "label": "t:settings.overflow_content",
      "options": [
        { "value": "hidden", "label": "t:options.hidden" },
        { "value": "visible", "label": "t:options.visible" }
      ],
      "default": "hidden",
      "visible_if": "{{ block.settings.type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_edge_fade",
      "label": "t:settings.show_edge_fade",
      "default": false,
      "visible_if": "{{ block.settings.type == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_on_mobile",
      "label": "t:settings.enable_swipe_on_mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_edge_fade_mobile",
      "label": "t:settings.show_edge_fade_mobile",
      "default": false,
      "visible_if": "{{ block.settings.type == 'carousel' and block.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "checkbox",
      "id": "swipe_custom_width_column",
      "label": "t:settings.swipe_custom_width_column",
      "default": false,
      "visible_if": "{{ block.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "swipe_column_width",
      "label": "t:settings.custom_width",
      "min": 20,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 76,
      "visible_if": "{{ block.settings.swipe_custom_width_column == true and block.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.grid_1_column"
        },
        {
          "value": "2",
          "label": "t:options.grid_2_column"
        }
      ],
      "default": "1",
      "visible_if": "{{ block.settings.swipe_custom_width_column == false or block.settings.enable_swipe_on_mobile == false }}"
    },
    {
      "type": "range",
      "id": "swipe_rows_mobile",
      "label": "t:settings.swipe_rows",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.enable_swipe_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.swipe_rows_mobile > 1 or block.settings.enable_swipe_on_mobile == false and block.settings.type == 'carousel' or block.settings.type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 10,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:settings.devices",
      "options": [
        {
          "value": "desktop",
          "label": "t:options.desktop"
        },
        {
          "value": "mobile",
          "label": "t:options.mobile"
        }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.featured_collection",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}

    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "t:settings.image_shape",
      "options": [
        {
          "value": "square",
          "label": "t:options.square_shape"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        }
      ],
      "default": "square",
      "visible_if": "{{ block.settings.card_style == 'media' and block.settings.card_layout == 'horizontal' }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "1/1",
          "label": "t:options.square"
        },
        {
          "value": "4/5",
          "label": "t:options.portrait"
        },
        {
          "value": "3/4",
          "label": "t:options.portrait_3_4"
        },
        {
          "value": "3/2",
          "label": "t:options.landscape_3_2"
        },
        {
          "value": "4/3",
          "label": "t:options.landscape_4_3"
        },
        {
          "value": "16/9",
          "label": "t:options.landscape"
        },
        {
          "value": "21/9",
          "label": "t:options.landscape_21_9"
        }
      ],
      "default": "1/1",
      "visible_if": "{{ block.settings.card_style == 'media' }}"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:settings.icon_size",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ block.settings.card_style == 'media' }}"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:settings.icon_color",
      "info": "t:info.leave_blank_to_use_default",

        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "card_padding",
      "label": "t:settings.padding",
      "options": [
        {
          "value": "compact",
          "label": "t:options.compact"
        },
        {
          "value": "comfortable",
          "label": "t:options.comfortable"
        }

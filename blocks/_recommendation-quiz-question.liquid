{% doc %}
  One Recommendation quiz question (dynamic, whitelisted by `sections/recommendation-quiz.liquid`).

  A thin wrapper: all markup lives in `snippets/product-quiz-question-markup.liquid`. Its cards are
  always the `_recommendation-quiz-option` children; the products come from their lists.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- capture options_html -%}
  {% content_for 'blocks' %}
{%- endcapture -%}
{%- render 'product-quiz-question-markup',
  block: block,
  section: section,
  options_html: options_html
-%}

{% schema %}
{
  "name": "t:names.recommendation_quiz_question",
  "tag": null,
  "blocks": [
    {
      "type": "_recommendation-quiz-option"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.general"
    },
    {
      "type": "text",
      "id": "question_id",
      "label": "t:settings.question_id",
      "info": "t:info.product_quiz_question_id"
    },
    {
      "type": "inline_richtext",
      "id": "help_text",
      "label": "t:settings.help_text",
      "info": "t:info.product_quiz_help_text"
    },
    {
      "type": "select",
      "id": "help_text_color",
      "label": "t:settings.help_text_color",
      "options": [
        {
          "value": "text",
          "label": "t:options.text"
        },
        {
          "value": "subtext",
          "label": "t:options.subtext"
        }
      ],
      "default": "subtext"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "t:settings.gap",
      "info": "t:info.product_quiz_question_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "header_gap_mobile",
      "label": "t:settings.mobile_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.header"
    },
    {
      "type": "text",
      "id": "stepper_label",
      "label": "t:settings.stepper_label",
      "info": "t:info.product_quiz_stepper_label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.product_quiz_heading_tokens",
      "default": "What are you shopping for?"
    },
    {
      "type": "select",
      "id": "question_heading_size",
      "label": "t:settings.heading_size",
      "options": [
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        }
      ],
      "default": "h2"
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "t:settings.subtext"
    },
    {
      "type": "select",
      "id": "subtext_color",
      "label": "t:settings.subtext_color",
      "options": [
        {
          "value": "text",
          "label": "t:options.text"
        },
        {
          "value": "subtext",
          "label": "t:options.subtext"
        }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:settings.text_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",

        {
          "value": "border",
          "label": "t:options.border"
        },
        {
          "value": "border_background",
          "label": "t:options.border_background"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "border"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "t:settings.title_size",
      "options": [
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        }
      ],
      "default": "paragraph"
    },
    {
      "type": "select",
      "id": "subtitle_color",
      "label": "t:settings.subtitle_color",
      "options": [
        {
          "value": "text",
          "label": "t:options.text"
        },
        {
          "value": "subtext",
          "label": "t:options.subtext"
        }
      ],
      "default": "subtext",
      "visible_if": "{{ block.settings.card_style == 'media' }}"
    },
    {
      "type": "select",
      "id": "card_layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "vertical",
          "label": "t:options.vertical"

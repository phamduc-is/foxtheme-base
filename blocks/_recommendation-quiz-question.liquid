        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.options"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "media",
          "label": "t:options.media_card"
        },
        {
          "value": "text",
          "label": "t:options.text_only"
        }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "selected_style",

    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.desktop_columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:settings.mobile_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "t:content.behavior"
    },
    {
      "type": "checkbox",
      "id": "allow_skip",

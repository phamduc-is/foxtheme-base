{% doc %}
  Start button of the product quiz intro (STATIC child of `blocks/_product-quiz-intro.liquid`, never
  added by hand: no presets). Start is an action, not a link, so this block has no Link setting and
  always renders a real `<button type="button">` through `button-markup`. The intro wraps it in
  `[data-quiz-start]` (`on:click="product-quiz/start"`); in the Finder quiz the runtime toggles
  `btn--loading` on the `<button>` while the first question is pre-fetched, which reveals the
  spinner passed in through `content_after`.

  A blank label falls back to the `blocks.product_quiz.start` string: as the visible text when no
  icon is chosen, or as the `aria-label` of an icon-only button, so the quiz always stays startable
  and the button always has an accessible name.

  @example
  {% content_for 'block', type: '_product-quiz-start-button', id: 'start-button' %}
{% enddoc %}

{%- liquid
  assign label = block.settings.label
  assign icon = block.settings.icon | default: 'none'
  assign icon_only = false
  if label == blank
    assign label = 'blocks.product_quiz.start' | t
    if icon != 'none'
      assign icon_only = true
    endif
  endif

  capture spinner
    render 'loading-spinner', size: 'small'
  endcapture
  assign spinner = spinner | strip
-%}
{% render 'button-markup',
  block: block,
  label: label,
  style: block.settings.style,
  size: block.settings.size,
  icon: icon,
  icon_only: icon_only,
  icon_end: block.settings.icon_end,
  tag: 'button',
  attributes: 'type="button"',
  content_after: spinner
%}

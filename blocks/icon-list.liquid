{%- if block.blocks.size > 0 -%}
  {%- liquid
    # Built here, not in the markup snippet: there `settings` is the block
    # settings param, so a `settings.animations_enabled` guard would read nil.
    assign list_motion = ''
    assign list_sequence = false
    if settings.animations_enabled
      assign animation_type = block.settings.animation_type
      if animation_type != 'none' and animation_type != blank
        assign list_motion = animation_type
        if block.settings.animation_sequence
          assign list_sequence = true
        endif
      endif
    endif
    capture motion_attrs
      if list_motion != blank
        echo ' is="motion-group"'
        render 'motion-attributes', type: list_motion, delay: block.settings.animation_delay, sequence: list_sequence
      endif
    endcapture
  -%}
  {%- capture list_items_html -%}
    {% content_for 'blocks' %}
  {%- endcapture -%}
  {% render 'icon-list-markup',
    settings: block.settings,
    shopify_attributes: block.shopify_attributes,
    list_items_html: list_items_html,
    motion_attrs: motion_attrs
  %}
{%- endif -%}

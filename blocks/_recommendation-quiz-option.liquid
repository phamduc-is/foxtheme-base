{% doc %}
  One answer card of a Recommendation quiz question (dynamic, whitelisted by
  `_recommendation-quiz-question`).

  A thin wrapper: all markup lives in `snippets/product-quiz-option-markup.liquid`. This block adds
  the Recommendation matching data: the strong / partial / exclude product lists. Results show
  every strong id (question order), then every partial id, minus every excluded id.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{%- liquid
  assign strong_ids = block.settings.strong_products | map: 'id' | join: ','
  assign partial_ids = block.settings.partial_products | map: 'id' | join: ','
  assign exclude_ids = block.settings.exclude_products | map: 'id' | join: ','
  assign title = block.settings.title
-%}
{%- render 'product-quiz-option-markup',
  block: block,
  matching: 'products',
  title: title,
  strong_ids: strong_ids,
  partial_ids: partial_ids,
  exclude_ids: exclude_ids
-%}


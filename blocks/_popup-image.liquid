<div
  class="subscribe-popup__image subscribe-popup__image--{{ block.settings.desktop_image_position }} relative shrink-0 w-full media-mask-clip"
  {{ block.shopify_attributes }}
>
  {% render 'responsive-image',
    mode: 'liquid',
    image: block.settings.image,
    image_mobile: block.settings.image_mobile,
    default_alt: shop.name,
    media_width_desktop: '440px',
    media_width_mobile: 'min(440px, calc(100vw - 32px))',
    use_aspect_ratio: true
  %}
</div>
{% schema %}
{
  "name": "t:names.popup_image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.image_mobile"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "t:settings.desktop_image_position",
      "info": "t:info.desktop_image_position",
      "default": "left",
      "options": [
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "left",
          "label": "t:options.left"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "paragraph",
      "content": "t:content.image_height_adapt"
    }
  ]
}
{% endschema %}

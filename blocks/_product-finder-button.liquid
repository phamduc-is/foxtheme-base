{% doc %}
  Internal submit button for `product-finder` (STATIC — rendered by the parent via
  `{% content_for 'block', type: '_product-finder-button', id: 'product-finder-button' %}`).

  Renders the finder's SUBMIT control as a typed `<button type="submit">` (NOT an `<a>`), composing
  the `.btn` classes like `button-markup`. Carries `ref="submit"` so `<product-finder>` can put it in a
  loading state during the Section-Rendering cascade fetch. Has its own preset so it's addable from the
  parent only — never placed globally.

  @example
  {% content_for 'block', type: '_product-finder-button', id: 'product-finder-button' %}
{% enddoc %}

{%- liquid
  assign settings = block.settings
  assign label = settings.label | default: 'Find products'
  assign style = settings.style | default: 'primary'
  assign size = settings.size | default: 'medium'
  assign icon = settings.icon | default: 'none'
  assign icon_end = settings.icon_end | default: false, allow_false: true

  assign btn_class = 'product-finder__submit btn btn--' | append: style | append: ' btn--' | append: size
  if icon != 'none'
    if label != blank
      assign btn_class = btn_class | append: ' btn--icon'
      if icon_end
        assign btn_class = btn_class | append: ' btn--icon-end'
      endif
    else
      assign btn_class = btn_class | append: ' btn--icon-only'
    endif
  endif
-%}

{%- capture button_style -%}
  {% render 'spacing-style', settings: settings %}
{%- endcapture -%}

<button
  type="submit"
  class="{{ btn_class | strip | strip_newlines }} spacing-style"
  style="{{ button_style | strip | strip_newlines }}"
  ref="submit"
  {{ block.shopify_attributes }}
>
  {%- if icon != 'none' and icon_end == false -%}
    {% render 'icon', icon: icon %}
  {%- endif -%}
  {%- if label != blank -%}
    <span class="btn__text" data-label="{{ label | escape }}">{{ label }}</span>
  {%- endif -%}
  {%- if icon != 'none' and icon_end -%}
    {% render 'icon', icon: icon %}
  {%- endif -%}
  {% render 'loading-spinner', size: 'small', class: 'product-finder__spinner' %}
</button>


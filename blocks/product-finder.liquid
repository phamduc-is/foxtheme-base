{% doc %}
  Product finder ("Shop By Vehicle") — public parent block.

  The heading and submit button are STATIC child blocks, rendered via `{% content_for 'block', … %}`
  and captured in block scope (`heading_html` / `button_html`); the cascade fields are dynamic children
  captured via `{% content_for 'blocks' %}` (`fields_html`). All three are passed to
  `product-finder-markup`, which lays out the form shell. The `<product-finder>` custom element enhances
  the native GET form with the sequential progressive-enable cascade, the loading state during fetches,
  and the JS-driven mobile collapse animation.

  Nested theme blocks can ONLY be rendered via `content_for` — iterating `block.blocks` + `{% render %}`
  silently renders nothing — so there is no `block.blocks` loop and no marker-comment split here.

  @example
  {% content_for 'block', type: 'product-finder', id: 'product-finder' %}
{% enddoc %}

{%- liquid
  assign settings = block.settings

  assign color_scheme = settings.color_scheme
  if settings.inherit_color_scheme
    assign color_scheme = ''
  endif

  assign target_collection = settings.collection
  assign target_url = '/collections/all'
  if target_collection != blank
    assign target_url = target_collection.url
  endif

  comment
    Fold border_opacity into a custom border_color so BOTH settings apply together
    (border-style only applies opacity to the scheme border color, not a custom one).
  endcomment
  assign border_alpha = settings.border_opacity | default: 100 | divided_by: 100.0

  comment
    Pre-assign: `render` tag arguments accept no filters, so the fallbacks
    (for block data saved before these settings existed) must resolve here.
  endcomment
  assign panel_padding_top = settings.panel_padding_top | default: 20
  assign panel_padding_top_mobile = settings.panel_padding_top_mobile | default: 20
  assign panel_padding_bottom = settings.panel_padding_bottom | default: 0
  assign panel_padding_bottom_mobile = settings.panel_padding_bottom_mobile | default: 0
-%}

{%- capture heading_html -%}
  {% content_for 'block', type: '_product-finder-heading', id: 'product-finder-heading' %}
{%- endcapture -%}
{%- capture button_html -%}
  {% content_for 'block', type: '_product-finder-button', id: 'product-finder-button' %}
{%- endcapture -%}
{%- capture fields_html -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- capture block_style -%}
  {% render 'spacing-style', settings: settings %}
  {% render 'border-style', settings: settings %}
  {% render 'size-style', settings: settings %}
  {%- if settings.border == 'solid' and settings.border_color != blank -%}
    --border-color: {{ settings.border_color | color_modify: 'alpha', border_alpha }};
  {%- endif -%}
  {% render 'clamp-calculate-style',
    property_name: 'pf-panel-pt',
    min_value: panel_padding_top_mobile,
    max_value: panel_padding_top
  %}
  {% render 'clamp-calculate-style',
    property_name: 'pf-panel-pb',
    min_value: panel_padding_bottom_mobile,
    max_value: panel_padding_bottom
  %}
{%- endcapture -%}

{%- render 'product-finder-markup',
  settings: settings,
  heading_html: heading_html,
  button_html: button_html,
  fields_html: fields_html,
  target_url: target_url,
  color_scheme: color_scheme,
  block_style: block_style,
  block_id: block.id,
  shopify_attributes: block.shopify_attributes
-%}

{% schema %}
{
  "name": "t:names.product_finder",
  "tag": null,
  "blocks": [
    { "type": "_product-finder-field" }
  ],
  "settings": [
    { "type": "header", "content": "t:content.general" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        { "value": "vertical", "label": "t:options.vertical" },
        { "value": "horizontal", "label": "t:options.horizontal" }
      ],
      "default": "horizontal"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.product_finder_collection"
    },
    {
      "type": "checkbox",
      "id": "mobile_collapsible",
      "label": "t:settings.mobile_collapsible",
      "default": true
    },
    { "type": "header", "content": "t:content.appearance" },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "solid", "label": "t:options.solid" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "visible_if": "{{ block.settings.border == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "t:settings.border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.border == 'solid' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_border_desktop",
      "label": "t:settings.hide_border_desktop",
      "default": false,
      "visible_if": "{{ block.settings.border == 'solid' }}"
    },
    {
      "type": "checkbox",
      "id": "hide_border_mobile",
      "label": "t:settings.hide_border_mobile",
      "default": false,
      "visible_if": "{{ block.settings.border == 'solid' }}"
    },
    { "type": "header", "content": "t:content.size" },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        { "value": "fit-content", "label": "t:options.fit" },
        { "value": "fill", "label": "t:options.fill" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        { "value": "fit-content", "label": "t:options.fit" },
        { "value": "fill", "label": "t:options.fill" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    { "type": "header", "content": "t:content.padding" },
    {
      "type": "select",
      "id": "device",
      "label": "t:settings.devices",
      "options": [
        { "value": "desktop", "label": "t:options.desktop" },
        { "value": "mobile", "label": "t:options.mobile" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    { "type": "header", "content": "t:content.content_padding" },
    {
      "type": "select",
      "id": "panel_device",
      "label": "t:settings.devices",
      "options": [
        { "value": "desktop", "label": "t:options.desktop" },
        { "value": "mobile", "label": "t:options.mobile" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "panel_padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.panel_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "panel_padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.panel_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "panel_padding_top_mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ block.settings.panel_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "panel_padding_bottom_mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.panel_device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_finder",
      "category": "t:categories.forms",
      "blocks": {
        "product-finder-heading": {
          "type": "_product-finder-heading",
          "static": true,
          "settings": {
            "heading": "<p>Find your product</p>",
            "type_preset": "h3",
            "icon": "funnel"
          }
        },
        "product-finder-button": {
          "type": "_product-finder-button",
          "static": true,
          "settings": {
            "label": "Find products",
            "style": "primary"
          }
        },
        "field_1": {
          "type": "_product-finder-field",

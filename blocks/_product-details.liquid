<div class="product-information__details sticky-element">
  {% capture children %}
    {% content_for 'blocks' %}
  {% endcapture %}
  {% render 'group-markup', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}
</div>
{% schema %}
{
  "name": "t:names.product_details",
  "tag": null,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    },
    {
      "type": "_product-review-stars"
    },
    {
      "type": "_product-info-group"
    },
    {
      "type": "_product-below-media"
    },
    {
      "type": "_breadcrumbs"
    },
    {
      "type": "_product-recommendations"
    },
    {
      "type": "_product-fbt"
    },
    {
      "type": "_product-title"
    },
    {
      "type": "_product-price"
    },
    {
      "type": "_variant-picker"
    },
    {
      "type": "_product-badges"
    },
    {
      "type": "_product-inventory"
    },
    {
      "type": "_promotion-alert"
    },
    {
      "type": "_pickup-availability"
    },
    {
      "type": "_buy-buttons"
    },
    {
      "type": "_product-description"
    },
    {
      "type": "_product-share"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.row_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:settings.row_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:settings.devices",
      "options": [
        { "value": "desktop", "label": "t:options.desktop" },
        { "value": "mobile", "label": "t:options.mobile" }
      ],
      "default": "desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.device == 'mobile' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_details",
      "blocks": {
        "product_title": {
          "type": "text",
          "settings": {
            "text": "<h1>{{ closest.product.title }}</h1>"
          }
        }
      },
      "block_order": ["product_title"]
    }
  ]
}
{% endschema %}

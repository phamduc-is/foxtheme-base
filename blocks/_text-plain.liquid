{% doc %}
  Plain text theme block — a stripped-down variant of the `text` block, for use
  inside a parent that owns its own layout and motion. Compared to `text` it
  drops the Layout group (width + alignment) and the Animation group; the parent
  handles those. Typography, colour and padding are unchanged.

  @param {string} [text_class] - Extra class(es) forwarded onto the text element (`class` is reserved by `content_for`).
  @param {string} [fallback_text] - Rendered when the text setting resolves blank — e.g. onboarding copy for a `{{ closest.* }}` dynamic source with no resource picked yet.
{% enddoc %}
{%- if block.settings.highlight_style != 'none' -%}
  {% render 'text-highlight-markup', block: block, class: text_class, fallback_text: fallback_text %}
{%- else -%}
  {% render 'text-markup', block: block, class: text_class, fallback_text: fallback_text %}
{%- endif -%}
{% schema %}
{
  "name": "t:names.text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:html_defaults.share_information_about_your"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "t:settings.highlight_style",
      "info": "t:info.highlight_style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "text-color",
          "label": "t:options.text_color"
        },
        {
          "value": "solid-background",
          "label": "t:options.solid_background"
        },
        {
          "value": "badge",
          "label": "t:options.badge"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "highlight_font_style",
      "label": "t:settings.highlight_font_style",

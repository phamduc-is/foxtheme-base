{% doc %}
  Suggested search queries panel for predictive search results.
  Reads `predictive_search.resources.queries`; renders nothing when empty.

  @example
  {% render 'predictive-search-result-queries-markup' %}
{% enddoc %}
{%- if predictive_search.resources.queries.size > 0 -%}
  <div class="search__result search__result--queries w-full flex flex-col gap-3">
    <h4 class="search__result-heading h6">
      {{- 'content.search_results_resource_queries' | t -}}
    </h4>
    <ul
      role="group"
      class="search__result-list flex flex-wrap gap-2 list-unstyled search__list--btn"
    >
      {%- for query in predictive_search.resources.queries -%}
        <li
          class="search__result-list-item flex"
          role="option"
          aria-selected="false"
        >
          <a
            class="btn btn--secondary btn--small paragraph"
            href="{{ query.url }}"
          >
            <span class="btn__text" data-label="{{ query.text | escape }}">{{- query.text }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

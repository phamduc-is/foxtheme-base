{% doc %}
  Products carousel shared by the predictive search recommendation and results panels.
  Shows carousel controls once `products` exceeds `columns_md` (the base desktop slides-per-view).

  @param {object} products - Product list to render as slides.
  @param {number} columns_xxl - Slides per view on desktop (≥1440px).
  @param {number} [columns_xl] - Slides per view at ≥1200px (defaults to `columns_xxl`).
  @param {number} [columns_lg] - Slides per view at ≥1024px (defaults to `columns_xl`).
  @param {number} [columns_md] - Slides per view at ≥768px (defaults to `columns_lg`).
  @param {number} columns_mobile - Slides per view on mobile (`swipe-mobile` cols).
  @param {number} column_gap - Gap (px) between slides on desktop.
  @param {number} column_gap_mobile - Gap (px) between slides on mobile.
  @param {string} media_sizes - `sizes` attribute forwarded to `product-card-markup`.

  @example
  {% render 'predictive-search-products-carousel-markup',
    products: predictive_search.resources.products,
    columns_xxl: columns_xxl,
    columns_xl: columns_xl,
    columns_lg: columns_lg,
    columns_md: columns_md,
    columns_mobile: columns_mobile,
    column_gap: column_gap,
    column_gap_mobile: column_gap_mobile,
    media_sizes: media_sizes
  %}
{% enddoc %}
{%- liquid
  assign columns_xl = columns_xl | default: columns_xxl
  assign columns_lg = columns_lg | default: columns_xl
  assign columns_md = columns_md | default: columns_lg
-%}
<carousel-slider
  class="carousel carousel--grid relative w-full"
  style="--f-columns-xxl: {{ columns_xxl }};--f-columns-xl: {{ columns_xl }};--f-columns-lg: {{ columns_lg }};--f-columns-md: {{ columns_md }};{% render 'gap-style', column_gap: column_gap, column_gap_mobile: column_gap_mobile %}"
>
  <script type="application/json" ref="config">
    {
      "slidesPerView": {{ columns_md }},
      "slidesPerGroup": {% render 'carousel-slides-per-group' %},
      "spaceBetween": {{ column_gap }},
      "loop": false,
      "pagination": false,
      "counter": false,
      "navigationPosition": {
        "enabled": true,
        "selector": ".product-card__media"
      },
      "destroyBelow": 768,
      "breakpoints": {
        "1024": {
          "slidesPerView": {{ columns_lg }}
        },
        "1200": {
          "slidesPerView": {{ columns_xl }}
        },
        "1440": {
          "slidesPerView": {{ columns_xxl }}
        }
      },
      "mousewheel": {
        "enabled": true,
        "forceToAxis": true,
        "thresholdTime": 300,
        "thresholdDelta": 10
      }
    }
  </script>
  <div ref="container" class="swiper swipe-mobile swipe-mobile--{{ columns_mobile }}-cols">
    <div class="swiper-wrapper swipe__inner">
      {%- for product in products -%}
        <div class="swiper-slide">
          {%- render 'product-card-markup',
            product: product,
            show_swatch: false,
            media_sizes: media_sizes,
            view_event_context: 'search'
          -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {% render 'carousel-controls', navigation: 'absolute-inside', navigation_size: 'small', pagination: 'none' %}
</carousel-slider>

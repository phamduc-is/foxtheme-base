{% doc %}
  Renders SVG icons for all payment methods enabled on the shop.
  Uses Shopify's payment_type_svg_tag filter; the list of icons is driven entirely by shop settings.

  @example
  {% render 'payment-icons' %}
{% enddoc %}

<ul class="list-unstyled flex items-center gap-2" aria-label="{{ 'content.payment_methods' | t }}">
  {%- for type in shop.enabled_payment_types -%}
    <li>
      {{ type | payment_type_svg_tag }}
    </li>
  {%- endfor -%}
</ul>

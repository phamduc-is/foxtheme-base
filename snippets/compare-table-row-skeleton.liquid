{% doc %}
  Renders the loading skeleton for ONE compare table column, as a `<template>`.

  Same shape as `compare-table-row-placeholder`: a single `<tr>` holding one
  `<td data-compare-key>` per section block, which compare.js clones once per
  compared product and distributes into the matching rows while it fetches the
  real cells.

  The bars mirror the real cell markup (media ratio, title, button, line count),
  so the table does not reflow when the fetched columns replace them.

  @param {object} section - Section providing the blocks the skeleton mirrors.

  @example
  {% render 'compare-table-row-skeleton', section: section %}
{% enddoc %}
<template data-compare-skeleton-row-template>
  <table>
    <tr>
      {%- for block in section.blocks -%}
        <td
          class="compare-table__col compare-table__col--type-{{ block.type }}"
          data-compare-key="{{ block.type }}"
          data-compare-skeleton-col
        >
          {%- case block.type -%}
            {%- when 'info' -%}
              <div class="compare-table__col-media relative">
                {%- comment -%}
                  Same wrapper as the real cell (compare-table-col-product-info): the radius
                  is clipped by the wrapper's overflow, so the bar inherits it for free and
                  stays in step if the merchant setting moves.
                {%- endcomment -%}
                <div
                  class="compare-table__col-image border-style"
                  style="{% render 'border-style', border_radius: block.settings.image_border_radius %}"
                >
                  <span class="compare-table__skeleton compare-table__skeleton--media"></span>
                </div>
              </div>
              <div class="compare-table__col-info text-center">
                <span class="compare-table__skeleton compare-table__skeleton--line" style="--skeleton-width: 70%"></span>
                {%- if block.settings.enable_view_details_button -%}
                  <span class="compare-table__skeleton compare-table__skeleton--button"></span>
                {%- endif -%}
              </div>
            {%- when 'price' -%}
              <span class="compare-table__skeleton compare-table__skeleton--line" style="--skeleton-width: 40%"></span>
            {%- when 'description' -%}
              {%- liquid
                # 'none' has no number to read and no rendered height to match — 3 lines is the
                # setting's own default, so an unlimited description starts from the same block.
                assign line_count = block.settings.text_line_limit | split: '-' | first | times: 1
                if line_count == 0
                  assign line_count = 3
                endif
              -%}
              <div class="flex flex-col gap-2">
                {%- for i in (1..line_count) -%}
                  <span
                    class="compare-table__skeleton compare-table__skeleton--line"
                    {% if forloop.last and line_count > 1 %}
                      style="--skeleton-width: 60%"
                    {% endif %}
                  ></span>
                {%- endfor -%}
              </div>
            {%- when 'variants' -%}
              <div class="flex flex-col gap-2">
                <span class="compare-table__skeleton compare-table__skeleton--line" style="--skeleton-width: 40%"></span>
                <div class="flex flex-wrap gap-2">
                  {%- for i in (1..3) -%}
                    <span class="compare-table__skeleton compare-table__skeleton--swatch"></span>
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <span class="compare-table__skeleton compare-table__skeleton--line" style="--skeleton-width: 60%"></span>
          {%- endcase -%}
        </td>
      {%- endfor -%}
    </tr>
  </table>
</template>

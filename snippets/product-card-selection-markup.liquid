{% doc %}
  Renders the HTML markup for a selectable product card used in multi-product selection UIs.
  Determines the variant-level URL by matching the featured media to a variant.
  Handles combined listings (linked products via option values) and no-swatch-selected state.
  Supports hover second image, image ratio, badges, vendor, and type.

  @param {object} product - The Shopify product object
  @param {string} [image_ratio] - Aspect ratio: 'auto' | 'adapt' | a numeric string (default: settings.pcard_aspect_ratio)
  @param {boolean} [show_second_image_on_hover] - Show second product image on hover (default: settings.show_second_image_on_hover)
  @param {boolean} [show_badges] - Desktop: show product badges (default: true)
  @param {boolean} [show_badges_mobile] - Mobile: show product badges (default: show_badges)
  @param {string} [badge_placement] - Where the badge group renders: 'auto' | 'on-media' | 'on-content' (default: 'auto')
  @param {boolean} [show_vendor] - Desktop: show vendor (default: settings.pcard_show_vendor)
  @param {boolean} [show_vendor_mobile] - Mobile: show vendor (default: show_vendor)
  @param {boolean} [show_type] - Desktop: show type (default: settings.pcard_show_type)
  @param {boolean} [show_type_mobile] - Mobile: show type (default: show_type)
  @param {string} [card_style] - Card visual style: 'default' | 'box' (default: settings.pcard_style)
  @param {object} [card_color_scheme] - Scheme object painting the box panel; only used under `card_style: 'box'` (default: settings.pcard_box_color_scheme)
  @param {object} [parent_color_scheme] - The host's scheme object. Only used to decide the ring, and only under `card_style: 'box'`: given both, a card whose background differs from its host drops the ring, since its own background already marks its edge
  @param {string} [loading] - Image loading attribute: 'lazy' | 'eager' (default: 'lazy')
  @param {string} [title_line_limit] - Max lines for title: 'none' | '1-line' | '2-lines' | '3-lines' (default: settings.pcard_title_line_limit)

  @example
  {% render 'product-card-selection-markup', product: product %}
{% enddoc %}

{% liquid
  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  assign combined_listing_count = product.options_with_values | map: 'values' | map: 'product_url' | compact | size
  assign no_swatch_selected = null

  unless combined_listing_count > 0
    # Simple direct check: which variant owns the featured image?
    if product.featured_media
      assign found_variant = false

      for variant in product.variants
        if variant.featured_media.id == product.featured_media.id
          assign variant_to_link = variant
          assign found_variant = true
          break
        endif
      endfor

      # Check if we need to set no_swatch_selected
      unless found_variant
        # Featured image is not a variant image
        # Check if product has swatches
        for option in product.options_with_values
          assign swatch_count = option.values | map: 'swatch' | compact | size
          if swatch_count > 1
            # Multiple swatches exist but featured image doesn't match any
            assign no_swatch_selected = true
            break
          endif
        endfor
      endunless
    endif
  endunless

  assign selected_variant = product.selected_or_first_available_variant
  assign featured_media = selected_variant.featured_media
  if selected_variant.featured_media == blank
    assign featured_media = product.featured_media
  endif

  assign featured_image = featured_media
  assign first_media_type = featured_media.media_type

  # Non-image media (video / external_video / model) only expose dimensions via preview_image.
  if first_media_type != 'image'
    assign featured_image = featured_media.preview_image
  endif

  assign show_second_image_on_hover = show_second_image_on_hover | default: settings.show_second_image_on_hover, allow_false: true
  assign second_image = ''
  if show_second_image_on_hover and product.images.size > 1 and product.images[1] != blank
    assign second_image = product.images[1]
  endif

  if image_ratio == blank
    assign image_ratio = settings.pcard_aspect_ratio | default: '1'
  endif
  if image_ratio == 'auto'
    if featured_image != blank
      assign image_ratio = featured_image.aspect_ratio
    else
      assign image_ratio = '1'
    endif
  endif

  # ── Badges ────────────────────────────────────────────────────────────────────
  # Same system as `product-card-bundle-markup`: a desktop/mobile pair plus an
  # explicit placement.
  assign show_badges = show_badges | default: true, allow_false: true
  assign show_badges_mobile = show_badges_mobile | default: show_badges, allow_false: true
  assign badge_placement = badge_placement | default: 'auto'

  assign has_badges = false
  if product != blank
    if show_badges or show_badges_mobile
      assign has_badges = true
    endif
  endif

  assign badge_device_class = ''
  unless show_badges_mobile
    assign badge_device_class = ' hidden md:block'
  endunless
  unless show_badges
    assign badge_device_class = ' block md:hidden'
  endunless

  assign render_badges_on_media = false
  assign render_badges_on_content = false
  assign badges_media_class = ''
  assign badges_content_class = ''
  if has_badges
    case badge_placement
      when 'on-media'
        assign render_badges_on_media = true
        assign badges_media_class = badge_device_class
      when 'on-content'
        assign render_badges_on_content = true
        assign badges_content_class = badge_device_class
      else
        if show_badges
          assign render_badges_on_media = true
          assign badges_media_class = ' hidden md:block'
        endif
        if show_badges_mobile
          assign render_badges_on_content = true
          assign badges_content_class = ' block md:hidden'
        endif
    endcase
  endif

  # 'media' (default): the sale badge travels with whichever badge GROUP renders.
  # 'content': it moves next to the price instead and is dropped from the groups.
  assign show_sale_badge_on_content = false
  assign show_sale_badge_on_media = false
  assign show_sale_badge_in_price = false
  if settings.pcard_show_sale_badge
    if settings.pcard_sale_badge_placement == 'content'
      assign show_sale_badge_in_price = true
    else
      assign show_sale_badge_on_content = render_badges_on_content
      assign show_sale_badge_on_media = render_badges_on_media
    endif
  endif

  assign loading = loading | default: 'lazy'
  assign media_sizes = media_sizes | default: ''
  assign media_widths = media_widths | default: ''

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif

  assign title_line_limit = title_line_limit | default: settings.pcard_title_line_limit | default: '1-line'

  # ── Card chrome ───────────────────────────────────────────────────────────────
  # Same axis as `product-card-markup`, but exposed as params so a host can pin the
  # style per section.
  assign card_style = card_style | default: settings.pcard_style | default: 'default'
  if card_color_scheme == blank
    assign card_color_scheme = settings.pcard_box_color_scheme
  endif

  # The ring, decided as `product-card-fbt-markup` decides its own: a boxed card on a
  # DIFFERENT background than its host needs none; on the SAME background — or with no
  # host scheme to compare — it keeps the ring, or it would vanish.
  assign show_card_border = false
  if card_style == 'box'
    assign show_card_border = true
    if card_color_scheme != blank and parent_color_scheme != blank
      assign show_card_border = false
      if card_color_scheme.settings.background.rgb == parent_color_scheme.settings.background.rgb
        assign show_card_border = true
      endif
    endif
  endif
%}
{%- capture card_classes -%}
  block product-card product-card--standard
  {%- if card_style == 'box' %} product-card--box{% endif -%}
  {%- if card_style == 'box' and card_color_scheme != blank %} color-{{ card_color_scheme }}{% endif -%}
  {%- if show_card_border %} product-card--box-border{% endif -%}
{%- endcapture -%}
{%- capture card_inline_style -%}
  --content-alignment: {{ settings.pcard_content_alignment }};
  --content-text-align: {{ settings.pcard_content_alignment | replace: 'flex-start', 'left' | replace: 'flex-end', 'right' }};
{%- endcapture -%}
<product-card
  class="{{ card_classes | strip | strip_newlines }}"
  style="{{ card_inline_style | strip | strip_newlines }}"
  {% if no_swatch_selected %}
    data-no-swatch-selected="true"
  {% endif %}
>
  <div
    class="product-card__wrapper flex flex-col"
    data-product-id="{{ product.id }}"
    data-product-card-wrapper
  >
    <div
      class="product-card__media media-hover--scale{% if second_image != blank %} product-card__media--has-second-image{% endif %} relative media-mask-clip w-full"
      data-variant-sync="media"
      style="--ratio: {{ image_ratio }};"
    >
      <a
        {% unless onboarding %}
          href="{{ variant_to_link.url }}"
        {% else %}
          role="link"
        {% endunless %}
        ref="cardGalleryLink"
        aria-label="{{ product.title | escape }}"
        tabindex="-1"
      >
        {%- if featured_image != blank -%}
          {% comment %}
             // Backup when need use video media instead of image
            {%- unless first_media_type == 'video' or first_media_type == 'external_video' -%}
            {%- else -%}
              <div class="media">
                {% render 'video-markup',
                  player_only: true,
                  video: featured_media,
                  video_autoplay: true,
                  video_loop: true,
                  section_id: section.id,
                  poster_size: '1200x',
                  disable_controls: true,
                  enable_toggle_button: false
                %}
              </div>
            {%- endunless -%}
          {% endcomment %}

          {% render 'responsive-image',
            mode: 'liquid',
            sizes: media_sizes,
            widths: media_widths,
            image: featured_image,
            image_ratio: image_ratio,
            class: 'product-card__image product-card__image--first',
            img_class: 'w-full',
            loading: loading,
            fetchpriority: fetchpriority
          %}

          {%- if second_image != blank -%}
            {% render 'responsive-image',
              mode: 'liquid',
              sizes: media_sizes,
              widths: media_widths,
              image: second_image,
              image_ratio: image_ratio,
              class: 'product-card__image product-card__image--second',
              img_class: 'w-full'
            %}
          {%- endif -%}
        {%- else -%}
          <div class="media media--placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
          </div>
        {%- endif -%}
      </a>
      {%- if render_badges_on_media -%}
        <product-badge
          data-product-id="{{ product.id }}"
          class="product-card__badges product-card__badges--on-media{{ badges_media_class }}"
        >
          {% render 'product-badges',
            product: product,
            use_variant: true,
            show_soldout_badge: settings.pcard_show_sold_out_badge,
            sale_badge_type: settings.pcard_sale_badge_type,
            show_sale_badge: show_sale_badge_on_media,
            show_custom_badges: settings.pcard_show_custom_badges,
            badge_layout: settings.pcard_badge_layout
          %}
        </product-badge>
      {%- endif -%}
    </div>
    <div class="product-card__content-wrap w-full flex flex-col gap-2">
      <div
        class="product-card__content flex flex-col"
        data-variant-sync="content"
      >
        {%- if render_badges_on_content -%}
          <product-badge
            data-product-id="{{ product.id }}"
            class="product-card__badges product-card__badges--on-content{{ badges_content_class }}"
          >
            {% render 'product-badges',
              product: product,
              use_variant: true,
              show_soldout_badge: settings.pcard_show_sold_out_badge,
              sale_badge_type: settings.pcard_sale_badge_type,
              show_sale_badge: show_sale_badge_on_content,
              show_custom_badges: settings.pcard_show_custom_badges,
              badge_layout: 'horizontal'
            %}
          </product-badge>
        {%- endif -%}
        {% render 'product-card-metas',
          product: product,
          show_vendor: show_vendor,
          show_vendor_mobile: show_vendor_mobile,
          show_type: show_type,
          show_type_mobile: show_type_mobile
        %}
        {%- if product != blank -%}
          <a
            class="product-card__title reversed-link text-limit-{{ title_line_limit }}"
            href="{% render 'product-card-variant-url', product: product %}"
            ref="productTitleLink"
            aria-label="{{ product.title | escape }}"
            tabindex="-1"
          >
            <span class="reversed-link__text">{{ product.title }}</span>
          </a>
        {%- else -%}
          <p class="product-card__title text-limit-{{ title_line_limit }}">
            <span>{{ 'placeholders.product_title' | t }}</span>
          </p>
        {%- endif -%}
        <product-price class="product-card__price">
          {% render 'price',
            show_unit_price: true,
            product_resource: product,
            use_variant: true,
            show_sale_badge: show_sale_badge_in_price,
            sale_badge_type: settings.pcard_sale_badge_type
          %}
        </product-price>
      </div>
      {%- unless onboarding -%}
        {%- liquid
          assign number_variants = product.variants | size
          assign hide_select = false
          if product.has_only_default_variant or number_variants == 1 and selected_variant.available == false
            assign hide_select = true
          endif
        -%}
        <product-bundle-selection
          class="product-card__form"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
        >
          <div class="select select--outline w-full{% if hide_select %} hidden{% endif %}">
            <label class="visually-hidden" for="SelectionCardVariant-{{ section.id }}-{{ product.id }}">
              {{- 'actions.choose_options' | t -}}
            </label>
            <select
              ref="variantSelect"
              on:change="/handleVariantChange"
              id="SelectionCardVariant-{{ section.id }}-{{ product.id }}"
              name="id"
              class="form-control w-full"
            >
              {%- for variant in product.variants -%}
                {%- capture option_ids -%}
                  {%- for option in variant.options -%}
                    {{- option.id -}}{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                {%- endcapture -%}
                <option
                  {% if variant.id == selected_variant.id or number_variants == 1 %}
                    selected="selected"
                  {% endif %}
                  {% if variant.available == false %}
                    disabled="disabled"
                  {% endif %}
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-options-id="{{ option_ids }}"
                >
                  {{ variant.title }}
                  {%- if variant.available == false %}
                    - {{ 'products.product.sold_out' | t -}}
                  {%- endif -%}
                </option>
              {%- endfor -%}
            </select>
          </div>
          <div class="product-form__buttons flex items-center flex-grow">
            <button
              on:click="/handleAddToBundle"
              ref="addToBundleButton"
              type="submit"
              name="add"
              class="product-form__submit btn btn--primary w-full"
              {% if selected_variant.available == false %}
                disabled
              {% endif %}
            >
              {%- capture selection_label -%}
                {%- if selected_variant.available -%}
                  {{- 'products.product.add_to_cart_short' | t -}}
                {%- else -%}
                  {{- 'products.product.sold_out' | t -}}
                {%- endif -%}
              {%- endcapture -%}
              <span class="btn__text" data-label="{{ selection_label | escape }}">{{ selection_label }}</span>
              {% render 'loading-spinner' %}
            </button>
          </div>
        </product-bundle-selection>
      {%- endunless -%}
    </div>
  </div>
</product-card>

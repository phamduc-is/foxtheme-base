{% doc %}
  CSS injected into the shopify-account shadow root by the header-account custom element.

  @example
  {% render 'header-account-css' %}
{% enddoc %}
<template ref="accountShadowStyles">
  <style>
    @keyframes dialogScaleIn {
      0% {
        transform: scale(0.8);
        opacity: 0;
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }
    @keyframes dialogScaleOut {
      0% {
        transform: scale(1);
        opacity: 1;
      }

      100% {
        transform: scale(0.8);
        opacity: 0;
      }
    }
    @keyframes dialogBackdropIn {
      0% {
        opacity: 0;
      }

      100% {
        opacity: 1;
      }
    }
    @keyframes dialogBackdropOut {
      0% {
        opacity: 1;
      }

      100% {
        opacity: 0;
      }
    }
    shopify-login-form {
      --shopify-account-radius-input: var(--input-border-radius);
    }
    .account__close svg {
      transition: transform var(--motion-ui-fast) var(--motion-ease);
    }
    .account__close:hover svg {
      transform: rotate(180deg);
    }
    .button {
      transition: all var(--timing-default) var(--easing-default);
      transition-property: color, background-color, border-color;
    }
    .button.outline:hover {
      color: rgb(var(--color-primary-button-text));
      background: rgb(var(--color-primary-button-background));
      border-color: rgb(var(--color-primary-button-background));
    }
    .account-button .account-button__avatar {
      width: var(--shopify-account-signed-in-avatar-size);
      height: var(--shopify-account-signed-in-avatar-size);
    }
    .account-button::before {
      content: '';
      position: absolute;
      inset: 0;
    }
    @media (min-width: 751px) {
      dialog .account {
        height: fit-content;
        background: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
        border-radius: inherit;
      }
      dialog[open] {
        animation: dialogScaleIn 0.6s cubic-bezier(0.7, 0, 0.2, 1) !important;
      }
      dialog.closing {
        animation: dialogScaleOut 0.6s cubic-bezier(0.7, 0, 0.2, 1) !important;
      }
      dialog[open]::backdrop {
        cursor: zoom-out;
        animation: dialogBackdropIn 0.8s cubic-bezier(0.7, 0, 0.2, 1) !important;
      }
      dialog.closing::backdrop {
        animation: dialogBackdropOut 0.8s cubic-bezier(0.7, 0, 0.2, 1) !important;
      }
    }
    @media (max-width: 750px) {
      dialog .account__content {
        padding-bottom: 2.4rem;
      }
    }
  </style>
</template>

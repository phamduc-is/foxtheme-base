{% doc %}
  Determines whether to wrap the localization-form in a dropdown-component and passes variables to it.

  @param {string} block_id - The block ID
  @param {boolean} [show_language] - Whether to show the language selector.
  @param {boolean} [show_country] - Whether to show the country selector.
  @param {boolean} [show_country_flag] - Whether to show the country flag on the toggle button.
  @param {boolean} [show_country_flag_in_list] - Whether to show a flag in each country list item. Defaults to show_country_flag.
  @param {string} [toggle_button_style] - Accepted value: 'plain', 'outline'
  @param {string} [toggle_button_class] - Extra CSS classes appended to the toggle button.
{% enddoc %}
{%- liquid
  assign toggle_button_style = toggle_button_style | default: 'plain'
  assign show_country_flag_in_list = show_country_flag_in_list | default: show_country_flag, allow_false: true
-%}
{%- if show_country == false -%}
  {%- if show_language and localization.available_languages.size > 1 -%}
    <div class="dropdown-localization">
      {% render 'localization-form',
        show_country: show_country,
        show_language: show_language,
        show_country_flag_in_list: show_country_flag_in_list,
        block_id: block_id
      %}
    </div>
  {%- endif -%}
{%- elsif localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  {%- capture toggle_button_classes -%}
    dropdown-localization__button dropdown-localization__button--{{ toggle_button_style }} relative z-0
    {%- if toggle_button_style == 'outline' %}
      btn btn--outline
    {%- else %}
      button-unstyled cursor-pointer
    {%- endif -%}
    {%- if toggle_button_class != blank %} {{ toggle_button_class }}{% endif -%}
  {%- endcapture -%}
  <dropdown-localization-component class="dropdown-localization block relative">
    <button
      type="button"
      class="{{ toggle_button_classes | strip | strip_newlines }}"
      aria-expanded="false"
      ref="toggle"
      on:click="/toggleSelector"
    >
      <div
        class="btn__text paragraph text-body-sm flex items-center gap-2{% if show_country_flag %} localization-flag{% endif %}"
        {% if show_country_flag %}
          style="--flag: url({{- localization.country | image_url: width: 32 }});"
        {% endif %}
      >
        <div>
          <span class="currency-code">
            {{- localization.country.currency.iso_code -}}
          </span>

          {%- if show_language -%}
            <span>/</span>
            <span>
              {{- localization.language.iso_code | upcase -}}
            </span>
          {%- endif -%}
        </div>
        {% render 'icon', icon: 'caret-down', size: 'extra-small', class: 'dropdown-localization__button-arrow shrink-0' %}
      </div>
    </button>
    {%- capture localization_popover -%}
      {{ 'component-localization-dropdown.css' | asset_url | stylesheet_tag }}
      <div
        class="localization-wrapper absolute color-background opacity-0"
        hidden
        ref="panel"
      >
        {% render 'localization-form',
          show_country: show_country,
          show_language: show_language,
          show_country_flag_in_list: show_country_flag_in_list,
          block_id: block_id
        %}
      </div>    
    {%- endcapture -%}
    <template ref="template">{{ localization_popover }}</template>
  </dropdown-localization-component>
{%- endif -%}

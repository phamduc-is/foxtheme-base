{% doc %}
  Deferred `<deferred-media>` video player, optionally wrapped in the theme **Video** block shell (`.video-block`).

  **Wrapped (default)** — Omit `player_only` or pass `false`. Renders size/spacing/border shell from `video_block_settings`, then the player. Intended for `blocks/video.liquid` only (`video_block_settings: block.settings`, `shopify_attributes`, `section_id`). Do not pass a snippet argument named `settings` here; it would shadow the theme global `settings` (e.g. `settings.animations_enabled` on the poster).

  **Player only** — `player_only: true`. Outputs the same player markup as before the `video` snippet was inlined; no `.video-block` wrapper. Pass `video` / URL flags / controls / `section_id` explicitly (see product media, slides, gallery, video card, etc.). Snippets rendered with `{% render %}` do not receive the parent `block` object unless you pass it as a named argument — this snippet does not read `block`; pass `video_autoplay`, `video_loop`, and `video_ratio` explicitly when needed.

  @param {boolean} [player_only] - When true, shell + `video_block_settings` are skipped; only the player is rendered.
  @param {object} [video_block_settings] - Wrapped mode: `block.settings` from `blocks/video.liquid` (`source`, `video`, `video_url`, `cover_image`, `alt`, `video_ratio`, `video_loop`, `video_autoplay`, plus fields consumed by `size-style`, `spacing-style`, `border-style`).
  @param {string} [shopify_attributes] - Wrapped mode: editor attributes on the outer `.video-block`.
  @param {string} [section_id] - Scope id on `<deferred-media>` as `data-section-id` (typically `section.id`; use `block.id` when the player must be unique per nested block, e.g. video cards).

  @param {object} [video] - Hosted Shopify video / media object, or embed id string when `video_from_url` is true.
  @param {boolean} [video_from_url] - When true, `video` is treated as the external id and `video_type` selects YouTube vs Vimeo iframe params.
  @param {string} [video_type] - With URL embeds: `youtube` or `vimeo`.
  @param {string} [video_alt] - Poster / iframe title; defaults from `video.alt` when hosted.
  @param {object} [video_preview_image] - Poster image object; defaults from `video.preview_image` when hosted.
  @param {string} [video_style] - Extra CSS for `<deferred-media>` `style` (e.g. aspect ratio vars from gallery).
  @param {string} [video_class] - Base classes before the snippet appends layout classes (`block relative z-0`).
  @param {string} [video_ratio] - Aspect token for poster / ratio logic (`auto`, `inherit`, or fixed ratio).
  @param {boolean} [video_loop]
  @param {boolean} [video_autoplay]
  @param {boolean} [disable_controls] - Hides native controls; pairs with optional custom toggle UI.
  @param {boolean} [enable_toggle_button] - Play/pause overlay when `disable_controls` is true.
  @param {boolean} [enable_toggle_volume_button] - Mute/unmute with `enable_toggle_button`.
  @param {string} [toggle_button_position] - `top` or default bottom placement for interaction controls.
  @param {string} [sizes] - Passed to `responsive-image` on the poster; defaults to a viewport-based string when blank.
  @param {string} [poster_size] - `image_size` for the autoplay `video_tag` poster (default `2500x`, right for a full-width hero). A card-sized caller passes something like `1200x`: Lighthouse flagged 2500px posters displayed at ~160px.
  @param {string} [loading] - `loading` for the poster and the no-video placeholder. Wrapped mode leaves it blank: it is then decided by `image-priority` from `section` + the block's `enable_preload_image`.
  @param {string} [fetchpriority] - Poster `fetchpriority`; decided the same way when blank.
  @param {object} [section] - Host section for `image-priority` (wrapped mode).
  @param {string} [additional_attributes] - Extra attributes on `<deferred-media>` / placeholder wrapper.
  @param {boolean} [video_overlay] - Renders `overlay` snippet over the player when true.
  @param {string} [video_overlay_color] - Overlay color (default semi-transparent).
{% enddoc %}
{%- liquid
  # Poster priority: a caller that already knows (hero, slide, gallery tile) passes
  # loading/fetchpriority. The video block leaves them blank, and they are decided
  # here from the section position + the block's own checkbox.
  if loading == blank and video_block_settings
    assign vb = video_block_settings
    capture priority
      render 'image-priority', section: section, preload: vb.enable_preload_image
    endcapture
    assign priority = priority | split: ','
    assign loading = priority[0]
    assign fetchpriority = priority[1]
  endif
-%}
{% unless player_only %}
{%- liquid
  assign vb = video_block_settings
  assign source = vb.source
  assign cover_image = vb.cover_image
  assign aspect_ratio = vb.video_ratio

  if vb.cover_image == blank
    if source == 'uploaded'
      assign cover_image = vb.video.preview_image
    endif
  endif

  assign default_aspect_ratio = '16/9'
  if aspect_ratio == 'auto'
    if source == 'uploaded'
      assign aspect_ratio = vb.video.aspect_ratio | default: cover_image.aspect_ratio | default: default_aspect_ratio
    else
      assign aspect_ratio = cover_image.aspect_ratio | default: default_aspect_ratio
    endif
  endif
-%}
{% capture video_style %}
  {% render 'border-style', settings: vb %}
  --size-style-aspect-ratio: {{ aspect_ratio }};
{% endcapture %}
<div
  class="video-block size-style spacing-style"
  style="{% render 'size-style', settings: vb %}{% render 'spacing-style', settings: vb %}"
  {{ shopify_attributes }}
>
{%- liquid
  if source == 'uploaded'
    assign video = vb.video
    assign video_from_url = false
    assign video_loop = vb.video_loop
    assign video_autoplay = vb.video_autoplay
    assign video_preview_image = cover_image
    assign video_style = video_style
    assign video_class = 'border-style'
    assign video_ratio = aspect_ratio
  else
    assign video_from_url = true
    assign video = vb.video_url.id
    assign video_type = vb.video_url.type
    assign video_alt = vb.alt
    assign video_preview_image = cover_image
    assign video_style = video_style
    assign video_class = 'border-style'
    assign video_ratio = aspect_ratio
    assign video_loop = vb.video_loop
    assign video_autoplay = vb.video_autoplay
  endif
-%}
{% endunless %}
{%- liquid
  assign video_alt = video_alt | default: video.alt
  assign alt = 'blocks.load_video' | t: description: video_alt
  assign video_preview_image = video_preview_image | default: video.preview_image
  assign media_width_desktop = 100 | divided_by: 2 | append: 'vw'
  assign media_width_mobile = '100vw'
  assign default_sizes = '(min-width: 768px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign sizes = sizes | default: default_sizes
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
  assign poster_size = poster_size | default: '2500x'
  assign video_class = video_class | append: ' block relative z-0'
  assign video_overlay = video_overlay | default: false, allow_false: true
  assign video_overlay_color = video_overlay_color | default: '#0000001a'

  assign media_type = ''
  if video_from_url
    assign media_type = video_type
  elsif video.host == 'youtube'
    assign media_type = 'youtube'
  elsif video.host == 'vimeo'
    assign media_type = 'vimeo'
  elsif video != blank
    assign media_type = 'video'
  endif

  assign preload_now = false
  if video_preview_image == blank and video_autoplay == false
    assign preload_now = true
  endif
-%}
{%- if video_from_url -%}
  {%- liquid
    if video_type == 'youtube'
      assign video_src = 'https://www.youtube.com/embed/VIDEO_ID?' | replace: 'VIDEO_ID', video

      if video_autoplay == false and video_preview_image != blank
        assign video_src = video_src | append: '&autoplay=1'
      endif

      if video_autoplay
        assign video_src = video_src | append: '&autoplay=1&mute=1'
      endif

      if video_loop
        assign video_src = video_src | append: '&playlist=' | append: video | append: '&loop=1'
      endif
      if disable_controls
        assign video_src = video_src | append: '&controls=0'
      endif
      assign video_src = video_src | append: '&enablejsapi=1'
      assign class = 'js-youtube'
      if video_preview_image == blank and disable_controls
        assign class = class | append: ' relative'
      endif
    else
      assign video_src = 'https://player.vimeo.com/video/VIDEO_ID?' | replace: 'VIDEO_ID', video

      if video_autoplay == false and video_preview_image != blank
        assign video_src = video_src | append: '&autoplay=1'
      endif

      if video_autoplay
        assign video_src = video_src | append: '&autoplay=1&muted=1'
      endif
      if video_loop
        assign video_src = video_src | append: '&loop=1'
      endif
      if disable_controls
        assign video_src = video_src | append: '&controls=0'
      endif
      assign video_src = video_src | append: '&api=1'
      assign class = 'js-vimeo'
      if video_preview_image == blank and disable_controls
        assign class = class | append: ' relative'
      endif
    endif
  -%}
  {%- capture video_iframe -%}
      <iframe
        src="{{ video_src }}&playsinline=1"
        class="{{ class }}"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
        title="{{ video_alt | escape }}"
        {% if preload_now %}loading="lazy"{% endif %}
        referrerpolicy="strict-origin-when-cross-origin"
        playsinline
      ></iframe>
  {%- endcapture -%}
{%- else -%}
  {%- liquid
    if disable_controls
      assign controls = false
      assign enable_js_api = true
    else
      assign controls = true
      assign enable_js_api = false
    endif

    if video_ratio == 'auto'
      if video_preview_image == blank
        assign video_ratio = video.aspect_ratio
      else
        assign video_ratio = video_preview_image.aspect_ratio
      endif
    else
      assign class = class | append: ' object-cover'
    endif
  -%}

  {%- capture video_tag -%}
    {% if video.host == 'youtube' %}
      {{
        video
        | external_video_url: autoplay: true, loop: video_loop, playlist: video.external_id, mute: '1', controls: controls, enablejsapi: enable_js_api, playsinline: '1'
        | external_video_tag: data-video-type: 'youtube'
      }}
    {% elsif video.host == 'vimeo' %}
      {{
        video
        | external_video_url: autoplay: true, loop: video_loop, muted: '1', controls: controls, api: enable_js_api, playsinline: '1'
        | external_video_tag: data-video-type: 'vimeo'
      }}
    {% else %}
      {{ video | video_tag: image_size: poster_size, autoplay: true, loop: video_loop, muted: true, controls: controls, class: class }}
    {% endif %}
  {%- endcapture -%}
{%- endif -%}
{%- if video != blank -%}
  <deferred-media
    class="{{ video_class | strip | strip_newlines }}"
    style="{{ video_style | strip | strip_newlines }}"
    {% if video_autoplay %}
      data-autoplay
    {% endif %}
    {% if media_type != blank %}
      data-media-type="{{ media_type }}"
    {% endif %}
    {% if disable_controls %}
      data-disable-controls
    {% endif %}
    {% if preload_now %}
      data-media-loaded="true"
    {% endif %}
    data-loading
    {{ additional_attributes }}
    data-section-id="{{ section_id }}"
  >
    <div class="deferred-media__loading z--1" aria-hidden="true"></div>
    {% if video_preview_image != blank %}
      <button
        class="button deferred-media__poster-button button-unstyled media media-hover--scale focus-visible--absolute{% if settings.animations_enabled and video_autoplay == false %} image-zoom-reveal{% endif %}"
        ref="deferredMediaPlayButton"
        aria-label="{{ alt }}"
        type="button"
        on:click="/showDeferredMedia"
        {% unless video_ratio == 'inherit' %}
          style="--video-aspect-ratio: {{ video_ratio }}"
        {% endunless %}
      >
        {% render 'responsive-image',
          mode: 'liquid',
          sizes: sizes,
          widths: widths,
          image: video_preview_image,
          default_alt: video_alt,
          class: 'w-full',
          loading: loading,
          fetchpriority: fetchpriority,
          with_wrapper: false
        %}

        <span class="deferred-media__poster-icon icon-play">
          <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
          {% render 'icon', icon: 'play' %}
        </span>
      </button>
    {% endif %}

    {%- if disable_controls -%}
      {% liquid
        assign toggle_button_position_class = 'bottom-0'
        if toggle_button_position == 'top'
          assign toggle_button_position_class = 'top-0'
        endif
      %}
      {%- if enable_toggle_button and enable_toggle_volume_button -%}
        <div class="video-interaction__controls video-interaction-hint hidden{% if video_preview_image == blank %} absolute inset-0{% endif %}">
          <div class="video-interaction__controls-inner flex flex-col md:flex-row items-end md:items-center md:justify-end gap-1 absolute left-0 right-0 {{ toggle_button_position_class }}">
            <button
              class="video-interaction__control"
              ref="toggleVolumeButton"
              type="button"
            >
              <span class="icon-mute hidden" aria-label="{{ 'accessibility.mute' | t }}">
                {% render 'icon', icon: 'mute' %}
              </span>
              <span class="icon-unmute hidden" aria-label="{{ 'accessibility.unmute' | t }}">
                {% render 'icon', icon: 'unmute' %}
              </span>
            </button>
            <button
              class="video-interaction__control"
              ref="toggleMediaButton"
              type="button"
              aria-label="{{ 'accessibility.play_video' | t }}"
              on:click="/toggleMedia"
            >
              <span class="icon-play hidden" aria-label="{{ 'accessibility.play_video' | t }}">
                {% render 'icon', icon: 'play' %}
              </span>
              <span class="icon-pause hidden" aria-label="{{ 'accessibility.pause_video' | t }}">
                {% render 'icon', icon: 'pause' %}
              </span>
            </button>
          </div>
        </div>
      {%- elsif enable_toggle_button -%}
        <button
          class="button button-unstyled deferred-media__poster-button video-interaction-hint hidden{% if video_preview_image == blank %} absolute inset-0{% endif %}"
          ref="toggleMediaButton"
          type="button"
          aria-label="{{ 'accessibility.play_video' | t }}"
          on:click="/toggleMedia"
        >
          <span class="deferred-media__poster-icon icon-play hidden">
            <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
            {% render 'icon', icon: 'play' %}
          </span>
          <span class="deferred-media__poster-icon icon-pause hidden">
            <span class="visually-hidden">{{ 'accessibility.pause_video' | t }}</span>
            {% render 'icon', icon: 'pause' %}
          </span>
        </button>
      {%- endif -%}
    {%- endif -%}

    <template>
      {%- if video_from_url -%}
        {{ video_iframe }}
      {%- else -%}
        {{ video_tag }}
      {%- endif -%}
    </template>

    {% if video_preview_image == blank and video_autoplay == false %}
      <div class="deferred-media__video-wrap">
        {%- if video_from_url -%}
          {{ video_iframe }}
        {%- else -%}
          {{ video_tag }}
        {%- endif -%}
      </div>
    {% endif %}

    {%- if video_overlay -%}
      {% render 'overlay', overlay_color: video_overlay_color %}
    {%- endif -%}
  </deferred-media>
{%- else -%}
  {%- liquid
    # `video_style` only carries an aspect ratio in wrapped mode; in `player_only`
    # mode the caller's `video_ratio` is the only ratio we have, so resolve it here
    # or the placeholder collapses to `aspect-ratio: auto`.
    assign placeholder_ratio = video_ratio
    if placeholder_ratio == 'auto' or placeholder_ratio == blank
      assign placeholder_ratio = video_preview_image.aspect_ratio | default: '16/9'
    endif
  -%}
  <div
    {{ additional_attributes }}
    class="{%- if video_class -%}{{ video_class | strip | strip_newlines }} {%- endif -%}video-placeholder-wrapper"
    style="{%- if video_style -%}{{ video_style | strip | strip_newlines }}{%- endif -%}{%- unless video_style contains 'aspect-ratio' or placeholder_ratio == 'inherit' -%}--size-style-aspect-ratio: {{ placeholder_ratio }};{%- endunless -%}"
  >
    {% if video_preview_image != blank and video_autoplay == false %}
      {{ video_preview_image | image_url: width: 3840 | image_tag: widths: widths, sizes: sizes, loading: loading, alt: video_alt }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {% endif %}
    <span class="video-placeholder-wrapper__poster-icon icon-play">
      <span class="visually-hidden">{{ 'accessibility.play_video' | t }}</span>
      {% render 'icon', icon: 'play' %}
    </span>
  </div>
{%- endif -%}
{% unless player_only %}
</div>
{% endunless %}

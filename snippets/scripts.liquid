{% doc %}
  Outputs the JavaScript import map and conditionally loaded <script> tags for all theme modules.
  The import map exposes

  @theme/* aliases to asset URLs for native ESM.
  Module scripts are loaded conditionally based on page context (section presence, feature flags, template type). Rendered once before </body> in the
  layout.

  @example
  {% render 'scripts' %}
{% enddoc %}

<!--
  ============================================================
    Import Map — must appear before any type="module" scripts
  ============================================================
-->
<script type="importmap">
  {
    "imports": {
      "@theme/utilities": "{{ 'utilities.js' | asset_url }}",
      "@theme/component": "{{ 'component.js' | asset_url }}",
      "@theme/events": "{{ 'events.js' | asset_url }}",
      "@theme/dialog": "{{ 'dialog.js' | asset_url }}",

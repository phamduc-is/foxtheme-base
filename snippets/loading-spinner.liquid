{% doc %}
  Renders an animated SVG loading spinner.

  @param {string} [size] - Icon size modifier: 'small' | 'medium' | 'large' (default: 'medium')
  @param {string} [class] - Additional CSS classes to append to the wrapper span
  @param {string} [attributes] - Raw HTML attributes string applied to the wrapper span

  @example
  {% render 'loading-spinner' %}
  @example
  {% render 'loading-spinner', size: 'small', class: 'hidden' %}
{% enddoc %}

{%- comment -%}
  data-motion-essential: a spinner that does not spin says "frozen", not
  "loading". This is the other exception to the global reduced-motion floor.
{%- endcomment -%}
<span
  data-motion-essential
  class="loading-spinner{% if class %} {{ class }}{% endif %}"
  {% if attributes %}
    {{ attributes -}}
  {% endif %}
>
  <svg
    aria-hidden="true"
    focusable="false"
    class="spinner icon icon--{{ size | default: 'medium' }}"
    viewBox="0 0 66 66"
    xmlns="http://www.w3.org/2000/svg"
  >
    <circle class="path" fill="none" stroke-width="4" cx="33" cy="33" r="30"></circle>
  </svg>
</span>

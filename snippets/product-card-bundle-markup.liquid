{% doc %}
  Renders the HTML markup for a product card in a bundle context.
  Handles image ratio (fixed, adapt, auto), hover second image, badges, vendor, and type.
  Used inside the product-bundle section and similar bundle UIs.

  @param {object} product - The Shopify product object
  @param {string} [mode] - Desktop layout: 'vertical' | 'horizontal' (default: 'vertical')
  @param {string} [mode_mobile] - Mobile layout: 'vertical' | 'horizontal' (default: mode)
  @param {string} [image_ratio] - Aspect ratio: 'auto' | 'adapt' | a numeric string (default: settings.pcard_aspect_ratio)
  @param {boolean} [show_second_image_on_hover] - Show second product image on hover (default: settings.show_second_image_on_hover)
  @param {boolean} [show_badges] - Desktop: show product badges (default: true)
  @param {boolean} [show_badges_mobile] - Mobile: show product badges (default: show_badges, or false when the host section sets `hide_product_badges_on_mobile`)
  @param {string} [badge_placement] - Where to render badges: 'on-media' | 'on-content' | 'auto' (default: 'auto' — on the media above md, in the content below, which is how this card has always rendered). This controls the badge GROUP; the sale badge itself also follows `settings.pcard_sale_badge_placement` — 'media' keeps it in the group, 'content' moves it next to the price.
  @param {boolean} [show_vendor] - Desktop: show vendor (default: settings.pcard_show_vendor)
  @param {boolean} [show_vendor_mobile] - Mobile: show vendor (default: show_vendor)
  @param {boolean} [show_type] - Desktop: show type (default: settings.pcard_show_type)
  @param {boolean} [show_type_mobile] - Mobile: show type (default: show_type)
  @param {string} [loading] - Image loading attribute: 'lazy' | 'eager' (default: 'lazy')
  @param {string} [product_title_line_limit] - Max lines for title: 'none' | '1-line' | '2-lines' | '3-lines' (default: settings.pcard_title_line_limit)

  @example
  {% render 'product-card-bundle-markup', product: product %}
{% enddoc %}

{% liquid
  # ── Layout mode ───────────────────────────────────────────────────────────────
  # Same pair, same defaults and the same `product-card--*` classes as
  # `product-card-markup`, so the core layout mixins own the arrangement instead of
  # the utility classes the wrapper used to hardcode. A caller that wants the row on
  # mobile this card used to hardcode asks for it: `mode_mobile: 'horizontal'`.
  assign mode = mode | default: 'vertical'
  assign mode_mobile = mode_mobile | default: mode

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  # The selected variant's own media wins over the product's, mirroring
  # `product-card-fbt-markup:24-35`. Without it the variant switch is invisible:
  # `ProductBundleVariantSelector` re-fetches the card with `?option_values=`
  # and swaps every `[data-variant-sync]` element, but the media it renders is
  # resolved from `product.featured_media`, so the "new" markup carries the same
  # image and nothing appears to change.
  assign featured_media = variant_to_link.featured_media
  if featured_media == blank
    assign featured_media = product.featured_media
  endif
  assign featured_image = featured_media
  assign featured_image_alt = featured_media.alt | default: product.title
  assign first_media_type = featured_media.media_type

  # Non-image media (video / external_video / model) only expose dimensions via preview_image.
  if first_media_type != 'image'
    assign featured_image = featured_media.preview_image
  endif

  assign show_second_image_on_hover = show_second_image_on_hover | default: settings.show_second_image_on_hover, allow_false: true
  assign second_image = ''
  if show_second_image_on_hover and product.images.size > 1 and product.images[1] != blank
    assign second_image = product.images[1]
  endif

  if image_ratio == blank
    assign image_ratio = settings.pcard_aspect_ratio | default: '1'
  endif
  if image_ratio == 'auto'
    if featured_image != blank
      assign image_ratio = featured_image.aspect_ratio
    else
      assign image_ratio = '1'
    endif
  endif

  # ── Badges ────────────────────────────────────────────────────────────────────
  # Same system as `product-card-markup`: a desktop/mobile pair plus an explicit
  # placement. The mobile default reads `hide_product_badges_on_mobile` — a
  # setting only `sections/product-bundle` defines — so that section keeps its
  # behaviour while every other caller just passes the param.
  assign show_badges = show_badges | default: true, allow_false: true
  assign show_badges_mobile_default = show_badges
  if section.settings.hide_product_badges_on_mobile
    assign show_badges_mobile_default = false
  endif
  assign show_badges_mobile = show_badges_mobile | default: show_badges_mobile_default, allow_false: true
  assign badge_placement = badge_placement | default: 'auto'

  assign has_badges = false
  if product != blank
    if show_badges or show_badges_mobile
      assign has_badges = true
    endif
  endif

  # A single explicit location carries the device utility itself; 'auto' keeps the
  # historical split (media above md, content below), one element per device.
  assign badge_device_class = ''
  unless show_badges_mobile
    assign badge_device_class = ' hidden md:block'
  endunless
  unless show_badges
    assign badge_device_class = ' block md:hidden'
  endunless

  assign render_badges_on_media = false
  assign render_badges_on_content = false
  assign badges_media_class = ''
  assign badges_content_class = ''
  if has_badges
    case badge_placement
      when 'on-media'
        assign render_badges_on_media = true
        assign badges_media_class = badge_device_class
      when 'on-content'
        assign render_badges_on_content = true
        assign badges_content_class = badge_device_class
      else
        if show_badges
          assign render_badges_on_media = true
          assign badges_media_class = ' hidden md:block'
        endif
        if show_badges_mobile
          assign render_badges_on_content = true
          assign badges_content_class = ' block md:hidden'
        endif
    endcase
  endif

  # The sale badge honours `pcard_sale_badge_placement`, mirroring the default
  # card — but through the PRICE, not through the badge groups.
  #
  # 'media' (default): the badge travels with whichever badge GROUP renders.
  # 'content': it moves next to the price instead, exactly where the default card
  # puts it, and is dropped from the groups.
  #
  # Gating the GROUPS by the store setting is what must not happen here: this card
  # renders one group per device (chosen by the caller's `badge_placement`), so a
  # group pinned 'on-media' while the store says 'content' would leave the badge
  # with no rendered home — it would silently disappear. Routing 'content' to the
  # price keeps it visible whatever the caller pins.
  assign show_sale_badge_on_content = false
  assign show_sale_badge_on_media = false
  assign show_sale_badge_in_price = false
  if settings.pcard_show_sale_badge
    if settings.pcard_sale_badge_placement == 'content'
      assign show_sale_badge_in_price = true
    else
      assign show_sale_badge_on_content = render_badges_on_content
      assign show_sale_badge_on_media = render_badges_on_media
    endif
  endif

  assign loading = loading | default: 'lazy'
  assign product_title_line_limit = product_title_line_limit | default: settings.pcard_title_line_limit | default: 'none'
  assign media_sizes = media_sizes | default: ''
  assign media_widths = media_widths | default: ''

  assign onboarding = false
  assign product_title = product.title
  if product.id == empty or product == blank
    assign onboarding = true
    assign product_title = 'placeholders.product_title' | t
  endif
%}
{%- capture card_classes -%}
  block w-full product-card product-card--bundle
  product-card--{{ mode }} product-card--mobile-{{ mode_mobile }}
  {%- if badge_placement == 'on-media' %} product-card--badge-on-media{% endif -%}
  {%- if badge_placement == 'on-content' %} product-card--badge-on-content{% endif -%}
{%- endcapture -%}
{%- capture card_style -%}
  {%- comment -%} Alignment only reads in the stacked arrangement — see `product-card-markup`. {%- endcomment -%}
  {%- if mode == 'vertical' or mode_mobile == 'vertical' -%}
    --content-alignment: {{ settings.pcard_content_alignment }};
    --content-text-align: {{ settings.pcard_content_alignment | replace: 'flex-start', 'left' | replace: 'flex-end', 'right' }};
  {%- endif -%}
{%- endcapture -%}
<product-card
  class="{{ card_classes }}"
  style="{{ card_style | strip | strip_newlines }}"
  {{ block.shopify_attributes }}
>
  <div
    class="product-card__wrapper"
    data-product-id="{{ product.id }}"
    data-product-card-wrapper
  >
    <div
      class="product-card__media media-hover--scale{% if second_image != blank %} product-card__media--has-second-image{% endif %} relative media-mask-clip w-full"
      data-variant-sync="media"
      style="--ratio: {{ image_ratio }};"
    >
      <a
        {% unless onboarding %}
          href="{{ variant_to_link.url }}"
        {% else %}
          role="link"
        {% endunless %}
        ref="cardGalleryLink"
        aria-label="{{ product_title | escape }}"
        tabindex="-1"
      >
        {%- if featured_image -%}
          {% comment %}
            // Backup when need use video media instead of image
             {%- unless first_media_type == 'video' or first_media_type == 'external_video' -%}
             {%- else -%}
               <div class="media">
                 {% render 'video-markup',
                   player_only: true,
                   video: featured_media,
                   video_autoplay: true,
                   video_loop: true,
                   section_id: section.id,
                   poster_size: '1200x',
                   disable_controls: true,
                   enable_toggle_button: false
                 %}
               </div>
             {%- endunless -%}
          {% endcomment %}
          {% render 'responsive-image',
            mode: 'liquid',
            sizes: media_sizes,
            widths: media_widths,
            image: featured_image,
            default_alt: featured_image_alt,
            image_ratio: image_ratio,
            class: 'product-card__image product-card__image--first',
            img_class: 'w-full',
            loading: loading,
            fetchpriority: fetchpriority
          %}

          {%- if second_image != blank -%}
            {% render 'responsive-image',
              mode: 'liquid',
              sizes: media_sizes,
              widths: media_widths,
              image: second_image,
              image_ratio: image_ratio,
              class: 'product-card__image product-card__image--second',
              img_class: 'w-full'
            %}
          {%- endif -%}
        {%- else -%}
          <div class="media media--placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
          </div>
        {%- endif -%}
      </a>
      {%- if render_badges_on_media -%}
        <product-badge
          data-product-id="{{ product.id }}"
          class="product-card__badges product-card__badges--on-media{{ badges_media_class }}"
        >
          {% render 'product-badges',
            product: product,
            use_variant: true,
            show_soldout_badge: settings.pcard_show_sold_out_badge,
            sale_badge_type: settings.pcard_sale_badge_type,
            show_sale_badge: show_sale_badge_on_media,
            show_custom_badges: settings.pcard_show_custom_badges,
            badge_layout: settings.pcard_badge_layout
          %}
        </product-badge>
      {%- endif -%}
    </div>
    <div class="product-card__content-wrap flex flex-col gap-2">
      <div
        class="product-card__content pointer-pass-through flex flex-col"
        data-variant-sync="content"
      >
        {%- if render_badges_on_content -%}
          <product-badge
            data-product-id="{{ product.id }}"
            class="product-card__badges product-card__badges--on-content{{ badges_content_class }}"
          >
            {% render 'product-badges',
              product: product,
              use_variant: true,
              show_soldout_badge: settings.pcard_show_sold_out_badge,
              sale_badge_type: settings.pcard_sale_badge_type,
              show_sale_badge: show_sale_badge_on_content,
              show_custom_badges: settings.pcard_show_custom_badges,
              badge_layout: 'horizontal'
            %}
          </product-badge>
        {%- endif -%}
        {% render 'product-card-metas',
          product: product,
          show_vendor: show_vendor,
          show_vendor_mobile: show_vendor_mobile,
          show_type: show_type,
          show_type_mobile: show_type_mobile
        %}
        {%- if product != blank -%}
          <a
            class="product-card__title text-wrap reversed-link text-limit-{{ product_title_line_limit }}"
            href="{% render 'product-card-variant-url', product: product %}"
            ref="productTitleLink"
            aria-label="{{ product_title | escape }}"
          >
            <span class="reversed-link__text">{{ product_title }}</span>
          </a>
        {%- else -%}
          <p class="product-card__title text-wrap">
            <span>{{ product_title }}</span>
          </p>
        {%- endif -%}
        <product-price class="product-card__price">
          {% render 'price',
            show_unit_price: true,
            product_resource: product,
            use_variant: true,
            show_sale_badge: show_sale_badge_in_price,
            sale_badge_type: settings.pcard_sale_badge_type
          %}
        </product-price>
        {% render 'product-card-volume-popover', product: product, section: section, block: block %}
      </div>
      {%- unless onboarding -%}
        {%- liquid
          assign product_form_id = 'product-form-' | append: section.id | append: block.id | append: product.id
          assign number_variants = product.variants | size
          assign hide_select = false
          if product.has_only_default_variant or number_variants == 1 and variant_to_link.available == false
            assign hide_select = true
          endif
        -%}
        {%- form 'product',
          product,
          id: product_form_id,
          class: 'product-card__form flex flex-col',
          data-type: 'add-to-cart-form',
          data-product-card-form: ''
        -%}
          {%- if product.quantity_price_breaks_configured? -%}
            {%- assign cart_qty = cart | item_count_for_variant: variant_to_link.id -%}
            <div
              class="product-card__quantity hidden"
              data-variant-sync="quantity"
            >
              {% render 'quantity-selector',
                section: section,
                block: block,
                product: product,
                variant: variant_to_link,
                in_cart_quantity: cart_qty,
                min: variant_to_link.quantity_rule.min,
                starting_quantity: variant_to_link.quantity_rule.min
              %}
            </div>
          {%- endif -%}
          <product-bundle-variant-selector
            class="select select--blank select--sizing-content{% if hide_select %} hidden{% endif %}"
            data-product-id="{{ product.id }}"
            data-product-url="{{ product.url }}"
            data-section-id="{{ section.id }}"
          >
            <label class="visually-hidden" for="BundleCardVariant-{{ section.id }}-{{ product.id }}">
              {{- 'actions.choose_options' | t -}}
            </label>
            <select
              ref="variantSelect"
              on:change="/onVariantChange"
              id="BundleCardVariant-{{ section.id }}-{{ product.id }}"
              name="id"
              class="form-control"
            >
              {%- for variant in product.variants -%}
                {%- capture option_ids -%}
                {%- for option in variant.options -%}
                  {{- option.id -}}{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              {%- endcapture -%}
                <option
                  {% if variant.id == variant_to_link.id or number_variants == 1 %}
                    selected="selected"
                  {% endif %}
                  {% if variant.available == false %}
                    disabled="disabled"
                  {% endif %}
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-options-id="{{ option_ids }}"
                >
                  {{ variant.title }}
                  {%- if variant.available == false %}
                    - {{ 'products.product.sold_out' | t -}}
                  {%- endif -%}
                </option>
              {%- endfor -%}
            </select>
          </product-bundle-variant-selector>
        {%- endform -%}
      {%- endunless -%}
    </div>
  </div>
</product-card>
